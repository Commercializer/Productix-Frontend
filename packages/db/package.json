    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.5.0",
    "@prisma/client": "^7.7.0",
    "@productix/types": "workspace:*",
    "bcryptjs": "^2.4.3",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "@prisma/config": "^6.5.0",
    "@types/node": "^20.11.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.0",
    "dotenv-cli": "^7.4.2",
    "prisma": "^7.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}