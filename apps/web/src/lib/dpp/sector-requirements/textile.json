{
  "sector": "TEXTILE",
  "sourceName": "Textile & Footwear",
  "sections": {
    "product-identification": {
      "label": "Product identification",
      "fields": [
        {
          "text": "Product name",
          "required": true
        },
        {
          "text": "GTIN-14",
          "required": true
        },
        {
          "text": "Sector",
          "required": true
        },
        {
          "text": "Type",
          "required": true,
          "type": "select",
          "options": [
            "Textile",
            "Footware"
          ]
        },
        {
          "text": "Brand name",
          "required": false
        },
        {
          "text": "Model number",
          "required": false
        },
        {
          "text": "Product category",
          "required": false
        },
        {
          "text": "HS Code",
          "required": false
        },
        {
          "text": "Product variants",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "One passport ↔ many variant GTINs (size × colour …). Each variant GTIN resolves to this passport - for textile/apparel placed on market as multiple SKUs that share the same sustainability data.",
          "required": false,
          "type": "note"
        },
        {
          "text": "Variant GTIN",
          "required": false
        },
        {
          "text": "Size",
          "required": false,
          "placeholder": "M"
        },
        {
          "text": "Color",
          "required": false,
          "placeholder": "Navy Blue"
        },
        {
          "text": "SKU",
          "required": false,
          "placeholder": "Optional"
        },
        {
          "text": "Add variant (New row, above fields again on new variant)",
          "required": false,
          "type": "button"
        }
      ]
    },
    "manufacturer-importer": {
      "label": "Manufacturer & importer",
      "fields": [
        {
          "text": "Manufacturer name",
          "required": true
        },
        {
          "text": "Manufacturer country",
          "required": true,
          "type": "country-picker",
          "searchable": true
        },
        {
          "text": "Manufacturer address",
          "required": false
        },
        {
          "text": "Manufacturer contact",
          "required": false
        },
        {
          "text": "Manufacturing facility ID",
          "required": false
        },
        {
          "text": "Manufacturing facility / site",
          "required": false,
          "helperText": "plant code or GS1 GLN). Optional - one of the 4 EU DPP Registry identifiers."
        },
        {
          "text": "Facility ID scheme - None / GLN (GS1) / EU-OP / Other",
          "required": false,
          "helperText": "Optional. Pick GLN only if the Facility ID is a GS1 GLN - it's then validated (13 digits)."
        },
        {
          "text": "Importer name",
          "required": false,
          "helperText": "Required if manufacturer is outside EU",
          "helperTextStyle": "lite"
        },
        {
          "text": "Importer country",
          "required": false,
          "type": "country-picker",
          "searchable": true
        }
      ]
    },
    "product-specifications": {
      "label": "Product specifications",
      "explainerText": "Free-form textile specifications displayed on the public viewer. Examples: Material composition · Fabric type · Fabric weight · Fiber content · Recycled content · Fabric finish · Color · Size.",
      "explainerText2": "Add the spec rows a consumer would care about. Up to 40 rows.",
      "explainerTextStyle": "lite",
      "maxRows": 40,
      "fields": [
        {
          "text": "Add Spec (Custom rows)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Spec Title",
          "required": false,
          "placeholder": "Fabric type"
        },
        {
          "text": "Spec Content",
          "required": false,
          "placeholder": "Jersey"
        }
      ]
    },
    "physical-properties": {
      "label": "Physical properties",
      "fields": [
        {
          "text": "Weight (kg)",
          "required": true
        },
        {
          "text": "Width (mm)",
          "required": false
        },
        {
          "text": "Height (mm)",
          "required": false
        },
        {
          "text": "Depth (mm)",
          "required": false
        },
        {
          "text": "Expected lifetime (years)",
          "required": false
        },
        {
          "text": "Warranty (years)",
          "required": false
        },
        {
          "text": "Manufacture date",
          "required": false,
          "type": "date-picker"
        },
        {
          "text": "Expiry date",
          "required": false,
          "type": "date-picker"
        }
      ]
    },
    "textile-data": {
      "label": "Textile data",
      "fields": [
        {
          "text": "Textile data",
          "required": false,
          "type": "section-heading"
        },
        {
          "text": "Fibre composition (Reg. 1007/2011)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Order from highest to lowest %. Sum should equal 100.",
          "required": false,
          "type": "note"
        },
        {
          "text": "Fibre name",
          "required": false,
          "placeholder": "Leather , Merino wool"
        },
        {
          "text": "Share %",
          "required": false,
          "placeholder": "85"
        },
        {
          "text": "Recycled %",
          "required": false,
          "placeholder": "0"
        },
        {
          "text": "Origin",
          "required": false,
          "type": "country-picker",
          "searchable": true
        },
        {
          "text": "Organic (checkbox)",
          "required": false,
          "type": "checkbox"
        },
        {
          "text": "Component",
          "required": false,
          "placeholder": "Sole / Upper / Lining",
          "helperText": "Component groups fibres/layers into one part (Ex: a sole)."
        },
        {
          "text": "Reusable",
          "required": false,
          "type": "checkbox",
          "helperText": "Mark Reusable to flag the whole component as reusable."
        },
        {
          "text": "Add fibre (Button - New row, above fields again on new fibre)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Fabric weight (g/m²)",
          "required": false,
          "placeholder": "280"
        },
        {
          "text": "Weave type",
          "required": false,
          "type": "select",
          "options": [
            "Woven",
            "Knitted",
            "Non-woven",
            "Felt",
            "Mesh",
            "Fleece",
            "Quilted",
            "Laminated"
          ]
        },
        {
          "text": "Yarn count",
          "required": false,
          "placeholder": "Nm 60/2"
        },
        {
          "text": "Origin & manufacturing chain",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Country of dyeing",
          "required": false,
          "type": "country-picker",
          "searchable": true
        },
        {
          "text": "Country of weaving / knitting",
          "required": false,
          "type": "country-picker",
          "searchable": true
        },
        {
          "text": "Country of cutting",
          "required": false,
          "type": "country-picker",
          "searchable": true
        },
        {
          "text": "Country of finishing",
          "required": false,
          "type": "country-picker",
          "searchable": true
        },
        {
          "text": "Factory ID - dyeing",
          "required": false,
          "placeholder": "HIGG-FEM-12345"
        },
        {
          "text": "Factory ID - cutting / sewing",
          "required": false,
          "placeholder": "OAR-67890"
        },
        {
          "text": "Environmental footprint (PEFCR Apparel v1.1)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Carbon footprint per garment (kg CO₂)",
          "required": false,
          "placeholder": "12.4"
        },
        {
          "text": "Water footprint per garment (L)",
          "required": false,
          "placeholder": "180"
        },
        {
          "text": "Land use (m²·yr) - (Natural fibres only)",
          "required": false,
          "placeholder": "3.2"
        },
        {
          "text": "PEF methodology",
          "required": false,
          "placeholder": "PEFCR Apparel and Footwear v1.1"
        },
        {
          "text": "PEF declaration URL",
          "required": false
        },
        {
          "text": "Chemicals & dyes",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Dye class",
          "required": false,
          "type": "select",
          "options": [
            "Reactive",
            "Disperse",
            "Direct",
            "Vat",
            "Sulfur",
            "Acid",
            "Pigment",
            "Natural",
            "None"
          ]
        },
        {
          "text": "Oeko-Tex class",
          "required": false,
          "placeholder": "Standard 100 Class I"
        },
        {
          "text": "REACH SVHC compliant",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "ZDHC MRSL compliant",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "PFAS-free",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Formaldehyde-free",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Durability",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Martindale abrasion cycles",
          "required": false,
          "placeholder": "40000",
          "helperText": "ISO 12947-2"
        },
        {
          "text": "Pilling resistance grade",
          "required": false,
          "placeholder": "4.5",
          "helperText": "1–5 per ISO 12945-2"
        },
        {
          "text": "Colour fastness - wash",
          "required": false,
          "placeholder": "4.5",
          "helperText": "ISO 105-C06"
        },
        {
          "text": "Colour fastness - light",
          "required": false,
          "placeholder": "6",
          "helperText": "1–8 per ISO 105-B02"
        },
        {
          "text": "Wash cycles durability",
          "required": false,
          "placeholder": "50",
          "helperText": "Expected wash cycles before fade/shrink"
        },
        {
          "text": "Tear strength (warp, N)",
          "required": false,
          "placeholder": "38.5"
        },
        {
          "text": "Microfibre shedding",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Shed rate (mg/kg per wash)",
          "required": false,
          "placeholder": "120"
        },
        {
          "text": "Test method",
          "required": false,
          "placeholder": "TMC 2024 / AATCC TM212"
        },
        {
          "text": "Recyclability & repairability",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Total recycled content (%)",
          "required": false
        },
        {
          "text": "Mono-material (≥95%)",
          "required": false,
          "helperText": "Critical signal for chemical recycling",
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Recyclability (%)",
          "required": false
        },
        {
          "text": "Recycling pathway",
          "required": false,
          "type": "select",
          "options": [
            "Mechanical",
            "Chemical",
            "Thermal",
            "Energy recovery",
            "Reuse first",
            "Not recyclable"
          ]
        },
        {
          "text": "Repair kit available",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Repair manual URL",
          "required": false
        },
        {
          "text": "Reuse / second-hand URL",
          "required": false
        },
        {
          "text": "Care instructions (ISO 3758)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Wash max (°C)",
          "required": false
        },
        {
          "text": "Bleach",
          "required": false,
          "type": "select",
          "options": [
            "Any bleach",
            "Chlorine only",
            "Non-chlorine only",
            "Do not bleach"
          ]
        },
        {
          "text": "Tumble dry",
          "required": false,
          "type": "select",
          "options": [
            "Low heat",
            "Medium heat",
            "High heat",
            "Do not tumble dry"
          ]
        },
        {
          "text": "Iron max (°C)",
          "required": false
        },
        {
          "text": "Dry-clean",
          "required": false,
          "type": "select",
          "options": [
            "Any solvent",
            "P (perchloroethylene)",
            "F (petroleum)",
            "W (wet-cleaning)",
            "Do not dry-clean"
          ]
        },
        {
          "text": "Free-text care notes",
          "required": true,
          "placeholder": "Wash inside-out, line dry, do not iron print."
        },
        {
          "text": "Certifications",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "GOTS (organic)",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Fairtrade",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Bluesign",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Cradle to Cradle",
          "required": false,
          "type": "select",
          "options": [
            "Basic",
            "Bronze",
            "Silver",
            "Gold",
            "Platinum"
          ]
        },
        {
          "text": "Responsible Wool Standard",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Responsible Down Standard",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Leather Working Group",
          "required": false,
          "type": "select",
          "options": [
            "Audited",
            "Bronze",
            "Silver",
            "Gold"
          ]
        },
        {
          "text": "EU Ecolabel licence",
          "required": false,
          "placeholder": "FR/16/001"
        }
      ]
    },
    "substances-of-concern-svhc": {
      "label": "Substances of concern (SVHC)",
      "fields": [
        {
          "text": "Substances of concern (SVHC)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "REACH 1907/2006 · Art. 33 - mandatory if >0.1% w/w (1000 ppm)",
          "required": false,
          "type": "note"
        },
        {
          "text": "Mandatory declaration threshold: >0.1% w/w (1000 ppm) per article. SVHC = Substance of Very High Concern (ECHA Candidate List).",
          "required": false,
          "component": "info_banner",
          "variant": "danger"
        },
        {
          "text": "Substance name",
          "required": false,
          "placeholder": "Cobalt"
        },
        {
          "text": "CAS number",
          "required": false,
          "placeholder": "7440-48-4"
        },
        {
          "text": "Conc. (ppm)",
          "required": false
        },
        {
          "text": "Location in product",
          "required": false,
          "placeholder": "Battery cell"
        },
        {
          "text": "SVHC",
          "required": false,
          "type": "checkbox"
        },
        {
          "text": "Add substance (New row, above fields again on new substance)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Compliance & certifications",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "CE Marking · REACH 1907/2006 · RoHS 2011/65/EU · ESPR 2024/1781",
          "required": false,
          "type": "note"
        },
        {
          "text": "CE marking",
          "required": false,
          "type": "toggle"
        },
        {
          "text": "REACH compliant",
          "required": false,
          "type": "toggle"
        },
        {
          "text": "RoHS compliant",
          "required": false,
          "type": "toggle"
        },
        {
          "text": "Energy efficiency class",
          "required": false,
          "type": "select",
          "options": [
            "A+++",
            "A++",
            "A+",
            "A",
            "B",
            "C",
            "D",
            "E",
            "F",
            "G"
          ]
        },
        {
          "text": "Energy consumption (kWh/year)",
          "required": false
        },
        {
          "text": "IP rating",
          "required": false,
          "placeholder": "IP67",
          "helperText": "IEC 60529"
        },
        {
          "text": "Third party certification",
          "required": false,
          "placeholder": "TÜV · UL · Bureau Veritas"
        }
      ]
    },
    "product-packaging": {
      "label": "Product packaging",
      "fields": [
        {
          "text": "Product packaging",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Packaging & Packaging Waste Regulation (EU) 2025/40 (PPWR) · ESPR 2024/1781. Declare one row per packaging layer.",
          "required": false,
          "type": "note"
        },
        {
          "text": "Layer order",
          "required": false
        },
        {
          "text": "Layer label",
          "required": false,
          "placeholder": "Primary bottle / Outer carton / Transport pallet"
        },
        {
          "text": "Data source",
          "required": false,
          "type": "select",
          "options": [
            "Manual entry",
            "Lookup by GTIN (Productix)",
            "External passport provider link",
            "Packaging layer (from library)"
          ]
        },
        {
          "text": "Packaging layer (from library)",
          "required": false,
          "type": "select",
          "helperText": "Select a shared layer defined via CSV import; referenced, not copied - edit it once and every product using it updates",
          "conditional": {
            "field": "Data source",
            "equals": "Packaging layer (from library)"
          }
        },
        {
          "text": "Packaging GTIN",
          "required": false,
          "conditional": {
            "field": "Data source",
            "equals": "Lookup by GTIN (Productix)"
          }
        },
        {
          "text": "Packaging DPP URL",
          "required": false,
          "placeholder": "https://www.productix.io/01/04796037382921",
          "conditional": {
            "field": "Data source",
            "equals": "External passport provider link"
          }
        },
        {
          "text": "Packaging name",
          "required": false,
          "placeholder": "Brown corrugated carton",
          "conditional": {
            "field": "Data source",
            "equals": "Manual entry"
          }
        },
        {
          "text": "Packaging manufacturer",
          "required": false,
          "placeholder": "EcoPack Industries (Pvt) Ltd",
          "conditional": {
            "field": "Data source",
            "equals": "Manual entry"
          }
        },
        {
          "text": "Packaging manufacturer country",
          "required": false,
          "type": "country-picker",
          "searchable": true,
          "conditional": {
            "field": "Data source",
            "equals": "Manual entry"
          }
        },
        {
          "text": "Required for the Declaration of Conformity",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Layer type (PPWR)",
          "required": false,
          "type": "select",
          "options": [
            "Primary",
            "Secondary",
            "Tertiary"
          ]
        },
        {
          "text": "Weight (g)",
          "required": false,
          "placeholder": "50"
        },
        {
          "text": "Layer composition",
          "required": false,
          "type": "nested-section",
          "helperText": "What this layer is physically made of — one row per material (Ex. bottle body · cap · label).",
          "fields": [
            {
              "text": "Component",
              "required": false,
              "placeholder": "Paper tray"
            },
            {
              "text": "Material",
              "required": true,
              "type": "select",
              "options": [
                "Paper / Cardboard",
                "PET",
                "HDPE",
                "LDPE",
                "PP",
                "PS",
                "Other plastic",
                "Glass",
                "Aluminium",
                "Steel",
                "Wood",
                "Composite",
                "Biopolymer",
                "Other"
              ]
            },
            {
              "text": "Weight (g)",
              "required": false,
              "placeholder": "g"
            },
            {
              "text": "Recycled %",
              "required": false,
              "placeholder": "%"
            }
          ],
          "actions": [
            {
              "text": "Add component (New row on above component fields)",
              "type": "button"
            }
          ]
        },
        {
          "text": "Recyclability grade (Art. 6-11)",
          "required": false,
          "type": "select",
          "options": [
            "A",
            "B",
            "C",
            "Not recyclable"
          ]
        },
        {
          "text": "Reusable",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "EPR registration",
          "required": false,
          "type": "nested-section",
          "helperText": "Extended Producer Responsibility registration(s) - one row per country.",
          "fields": [
            {
              "text": "Country",
              "required": true,
              "type": "country-picker",
              "searchable": true
            },
            {
              "text": "Scheme name",
              "required": true,
              "placeholder": "Scheme name"
            },
            {
              "text": "Registration No.",
              "required": true,
              "placeholder": "Registration No."
            }
          ],
          "actions": [
            {
              "text": "Add EPR registration (New row on above EPR fields)",
              "type": "button"
            }
          ]
        },
        {
          "text": "CONFORMITY & DECLARATION OF CONFORMITY (ART 38/39)",
          "required": false,
          "type": "section-heading"
        },
        {
          "text": "DoC number",
          "required": false,
          "placeholder": "DoC-2026-001"
        },
        {
          "text": "DoC issue date",
          "required": false,
          "type": "date-picker",
          "placeholder": "dd/mm/yyyy"
        },
        {
          "text": "EU DoC exists",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "REACH / SVHC compliant",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Declaration of Conformity URL",
          "required": false,
          "placeholder": "https://..."
        },
        {
          "text": "Upload DoC file",
          "required": false,
          "type": "file-upload"
        },
        {
          "text": "Extract data from DoC",
          "required": false,
          "type": "button"
        },
        {
          "text": "Generate DoC (preview)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Generate + archive DoC",
          "required": false,
          "type": "button"
        },
        {
          "text": "Generated from the fields above (same template as the sector). Saves the product first. If your company logo/signature are not set, the DoC is generated without them.",
          "required": false,
          "type": "description"
        },
        {
          "text": "Save layer",
          "required": false,
          "type": "button"
        }
      ]
