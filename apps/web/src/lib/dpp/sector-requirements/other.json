{
  "sector": "OTHER",
  "sourceName": "Other",
  "sections": {
    "product-identification": {
      "label": "Product identification",
      "fields": [
        {
          "text": "Product name",
          "required": true
        },
        {
          "text": "GTIN-14",
          "required": true,
          "helperText": "14-digit Global Trade Item Number"
        },
        {
          "text": "Sector",
          "required": true
        },
        {
          "text": "Brand name",
          "required": false
        },
        {
          "text": "Model number",
          "required": false
        },
        {
          "text": "Product category",
          "required": false
        },
        {
          "text": "HS Code",
          "required": false
        }
      ]
    },
    "manufacturer-importer": {
      "label": "Manufacturer & importer",
      "fields": [
        {
          "text": "Manufacturer name",
          "required": true
        },
        {
          "text": "Manufacturer country",
          "required": true,
          "type": "country-picker",
          "searchable": true
        },
        {
          "text": "Manufacturer address",
          "required": false
        },
        {
          "text": "Manufacturer contact",
          "required": false
        },
        {
          "text": "Manufacturing facility ID",
          "required": false
        },
        {
          "text": "Manufacturing facility / site",
          "required": false,
          "helperText": "plant code or GS1 GLN). Optional - one of the 4 EU DPP Registry identifiers."
        },
        {
          "text": "Facility ID scheme - None / GLN (GS1) / EU-OP / Other",
          "required": false,
          "helperText": "Optional. Pick GLN only if the Facility ID is a GS1 GLN - it's then validated (13 digits)."
        },
        {
          "text": "Importer name",
          "required": false,
          "helperText": "Required if manufacturer is outside EU",
          "helperTextStyle": "lite"
        },
        {
          "text": "Importer country",
          "required": false,
          "type": "country-picker",
          "searchable": true
        }
      ]
    },
    "product-specifications": {
      "label": "Product specifications",
      "explainerText": "Free-form construction product specifications displayed on the public viewer. Examples: Material · Dimensions · Weight · Grade · Strength class · Thermal conductivity · Fire rating · Durability · Recycled content · Surface finish.",
      "explainerText2": "Add the spec rows a consumer would care about. Up to 40 rows.",
      "explainerTextStyle": "lite",
      "maxRows": 40,
      "fields": [
        {
          "text": "Add Spec (Custom rows)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Spec Title",
          "required": false,
          "placeholder": "Material"
        },
        {
          "text": "Spec Content",
          "required": false,
          "placeholder": "Reinforced concrete"
        }
      ]
    },
    "physical-properties": {
      "label": "Physical properties",
      "fields": [
        {
          "text": "Weight (kg)",
          "required": true
        },
        {
          "text": "Width (mm)",
          "required": false
        },
        {
          "text": "Height (mm)",
          "required": false
        },
        {
          "text": "Depth (mm)",
          "required": false
        },
        {
          "text": "Expected lifetime (years)",
          "required": false
        },
        {
          "text": "Warranty (years)",
          "required": false
        },
        {
          "text": "Manufacture date",
          "required": false,
          "type": "date-picker"
        },
        {
          "text": "Expiry date",
          "required": false,
          "type": "date-picker"
        }
      ]
    },
    "carbon-footprint": {
      "label": "Carbon footprint",
      "fields": [
        {
          "text": "ESPR 2024/1781 · Art. 7(2)(b) - product carbon footprint",
          "required": false,
          "type": "note"
        },
        {
          "text": "Total CO₂ equivalent (kg)",
          "required": true,
          "helperText": "Mandatory for batteries ≥2kWh from Feb 2027"
        },
        {
          "text": "Methodology",
          "required": false,
          "helperText": "Ex: ISO 14067:2018"
        },
        {
          "text": "Manufacturing phase (kg CO₂)",
          "required": false
        },
        {
          "text": "Transport phase (kg CO₂)",
          "required": false
        },
        {
          "text": "Use phase (kg CO₂)",
          "required": false
        },
        {
          "text": "End of life phase (kg CO₂)",
          "required": false
        },
        {
          "text": "EPD declaration URL",
          "required": false
        }
      ]
    },
    "recycled-content": {
      "label": "Recycled content",
      "fields": [
        {
          "text": "Battery Regulation 2023/1542 · Art. 8 - mandatory from 2031",
          "required": false,
          "type": "note"
        },
        {
          "component": "info_banner",
          "variant": "success",
          "text": "Battery targets 2031 — Cobalt ≥16% · Lithium ≥6% · Nickel ≥6% · Lead ≥85%"
        },
        {
          "text": "Total recycled content (%)",
          "required": true,
          "helperText": "Mandatory for batteries from 2031"
        },
        {
          "text": "Pre-consumer recycled (%)",
          "required": false
        },
        {
          "text": "Post-consumer recycled (%)",
          "required": false
        },
        {
          "text": "Renewable content (%)",
          "required": false
        },
        {
          "text": "Recyclability (%)",
          "required": false
        }
      ]
    },
    "material-composition": {
      "label": "Material composition",
      "fields": [
        {
          "text": "ESPR 2024/1781 · Art. 7(5) · Critical Raw Materials Act 2024/1252, Declare all materials >0.1% by weight. Country of origin mandatory for Critical Raw Materials (CRM).",
          "required": false,
          "type": "note"
        },
        {
          "text": "Declare all materials >0.1% by weight. Country of origin mandatory for Critical Raw Materials (CRM).",
          "required": false,
          "component": "info_banner",
          "variant": "warning"
        },
        {
          "type": "select",
          "name": "material_name",
          "label": "Material name",
          "required": false,
          "options": [
            "Lithium",
            "Cobalt",
            "Nickel",
            "Manganese",
            "Graphite",
            "Rare earth elements",
            "Platinum",
            "Palladium",
            "Indium",
            "Gallium",
            "Germanium",
            "Silicon metal",
            "Titanium",
            "Tungsten",
            "Niobium",
            "Tantalum",
            "Aluminum",
            "Steel",
            "Copper",
            "Iron",
            "Zinc",
            "Lead",
            "Tin",
            "Silver",
            "Gold",
            "Polypropylene (PP)",
            "Polyethylene (PE)",
            "PET",
            "ABS plastic",
            "Nylon",
            "Polycarbonate",
            "Cotton",
            "Polyester",
            "Glass",
            "Ceramic"
          ]
        },
        {
          "text": "Share (%)",
          "required": false
        },
        {
          "text": "Origin",
          "required": false,
          "type": "country-picker",
          "searchable": true
        },
        {
          "text": "Flags",
          "required": false,
          "type": "checkbox",
          "options": [
            "CRM",
            "Recycled"
          ]
        },
        {
          "text": "Rec. %",
          "required": false
        },
        {
          "text": "Add Material (New row, above fields again on new materials)",
          "required": false,
          "type": "button"
        }
      ]
    },
    "substances-of-concern-svhc": {
      "label": "Substances of concern (SVHC)",
      "fields": [
        {
          "text": "Substances of concern (SVHC)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "REACH 1907/2006 · Art. 33 - mandatory if >0.1% w/w (1000 ppm)",
          "required": false,
          "type": "note"
        },
        {
          "text": "Mandatory declaration threshold: >0.1% w/w (1000 ppm) per article. SVHC = Substance of Very High Concern (ECHA Candidate List).",
          "required": false,
          "component": "info_banner",
          "variant": "danger"
        },
        {
          "text": "Substance name",
          "required": false,
          "placeholder": "Cobalt"
        },
        {
          "text": "CAS number",
          "required": false,
          "placeholder": "7440-48-4"
        },
        {
          "text": "Conc. (ppm)",
          "required": false
        },
        {
          "text": "Location in product",
          "required": false,
          "placeholder": "Battery cell"
        },
        {
          "text": "SVHC",
          "required": false,
          "type": "checkbox"
        },
        {
          "text": "Add substance (New row, above fields again on new substance)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Compliance & certifications",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "CE Marking · REACH 1907/2006 · RoHS 2011/65/EU · ESPR 2024/1781",
          "required": false,
          "type": "note"
        },
        {
          "text": "CE marking",
          "required": false,
          "type": "toggle"
        },
        {
          "text": "REACH compliant",
          "required": false,
          "type": "toggle"
        },
        {
          "text": "RoHS compliant",
          "required": false,
          "type": "toggle"
        },
        {
          "text": "Energy efficiency class",
          "required": false,
          "type": "select",
          "options": [
            "A+++",
            "A++",
            "A+",
            "A",
            "B",
            "C",
            "D",
            "E",
            "F",
            "G"
          ]
        },
        {
          "text": "Energy consumption (kWh/year)",
          "required": false
        },
        {
          "text": "IP rating",
          "required": false,
          "placeholder": "IP67",
          "helperText": "IEC 60529"
        },
        {
          "text": "Third party certification",
          "required": false,
          "placeholder": "TÜV · UL · Bureau Veritas"
        }
      ]
    },
    "product-packaging": {
      "label": "Product packaging",
      "fields": [
        {
          "text": "Product packaging",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Packaging & Packaging Waste Regulation (EU) 2025/40 (PPWR) · ESPR 2024/1781. Declare one row per packaging layer.",
          "required": false,
          "type": "note"
        },
        {
          "text": "Layer order",
          "required": false
        },
        {
          "text": "Layer label",
          "required": false,
          "placeholder": "Primary bottle / Outer carton / Transport pallet"
        },
        {
          "text": "Data source",
          "required": false,
          "type": "select",
          "options": [
            "Manual entry",
            "Lookup by GTIN (Productix)",
            "External passport provider link",
            "Packaging layer (from library)"
          ]
        },
        {
          "text": "Packaging layer (from library)",
          "required": false,
          "type": "select",
          "helperText": "Select a shared layer defined via CSV import; referenced, not copied - edit it once and every product using it updates",
          "conditional": {
            "field": "Data source",
            "equals": "Packaging layer (from library)"
          }
        },
        {
          "text": "Packaging GTIN",
          "required": false,
          "conditional": {
            "field": "Data source",
            "equals": "Lookup by GTIN (Productix)"
          }
        },
        {
          "text": "Packaging DPP URL",
          "required": false,
          "placeholder": "https://www.productix.io/01/04796037382921",
          "conditional": {
            "field": "Data source",
            "equals": "External passport provider link"
          }
        },
        {
          "text": "Packaging name",
          "required": false,
          "placeholder": "Brown corrugated carton",
          "conditional": {
            "field": "Data source",
            "equals": "Manual entry"
          }
        },
        {
          "text": "Packaging manufacturer",
          "required": false,
          "placeholder": "EcoPack Industries (Pvt) Ltd",
          "conditional": {
            "field": "Data source",
            "equals": "Manual entry"
          }
        },
        {
          "text": "Packaging manufacturer country",
          "required": false,
          "type": "country-picker",
          "searchable": true,
          "conditional": {
            "field": "Data source",
            "equals": "Manual entry"
          }
        },
        {
          "text": "Required for the Declaration of Conformity",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Layer type (PPWR)",
          "required": false,
          "type": "select",
          "options": [
            "Primary",
            "Secondary",
            "Tertiary"
          ]
        },
        {
          "text": "Weight (g)",
          "required": false,
          "placeholder": "50"
        },
        {
          "text": "Layer composition",
          "required": false,
          "type": "nested-section",
          "helperText": "What this layer is physically made of — one row per material (Ex. bottle body · cap · label).",
          "fields": [
            {
              "text": "Component",
              "required": false,
              "placeholder": "Paper tray"
            },
            {
              "text": "Material",
              "required": true,
              "type": "select",
              "options": [
                "Paper / Cardboard",
                "PET",
                "HDPE",
                "LDPE",
                "PP",
                "PS",
                "Other plastic",
                "Glass",
                "Aluminium",
                "Steel",
                "Wood",
                "Composite",
                "Biopolymer",
                "Other"
              ]
            },
            {
              "text": "Weight (g)",
              "required": false,
              "placeholder": "g"
            },
            {
              "text": "Recycled %",
              "required": false,
              "placeholder": "%"
            }
          ],
          "actions": [
            {
              "text": "Add component (New row on above component fields)",
              "type": "button"
            }
          ]
        },
        {
          "text": "Recyclability grade (Art. 6-11)",
          "required": false,
          "type": "select",
          "options": [
            "A",
            "B",
            "C",
            "Not recyclable"
          ]
        },
        {
          "text": "Reusable",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "EPR registration",
          "required": false,
          "type": "nested-section",
          "helperText": "Extended Producer Responsibility registration(s) - one row per country.",
          "fields": [
            {
              "text": "Country",
              "required": true,
              "type": "country-picker",
              "searchable": true
            },
            {
              "text": "Scheme name",
              "required": true,
              "placeholder": "Scheme name"
            },
            {
              "text": "Registration No.",
              "required": true,
              "placeholder": "Registration No."
            }
          ],
          "actions": [
            {
              "text": "Add EPR registration (New row on above EPR fields)",
              "type": "button"
            }
          ]
        },
        {
          "text": "CONFORMITY & DECLARATION OF CONFORMITY (ART 38/39)",
          "required": false,
          "type": "section-heading"
        },
        {
          "text": "DoC number",
          "required": false,
          "placeholder": "DoC-2026-001"
        },
        {
          "text": "DoC issue date",
          "required": false,
          "type": "date-picker",
          "placeholder": "dd/mm/yyyy"
        },
        {
          "text": "EU DoC exists",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "REACH / SVHC compliant",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Declaration of Conformity URL",
          "required": false,
          "placeholder": "https://..."
        },
        {
          "text": "Upload DoC file",
          "required": false,
          "type": "file-upload"
        },
        {
          "text": "Extract data from DoC",
          "required": false,
          "type": "button"
        },
        {
          "text": "Generate DoC (preview)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Generate + archive DoC",
          "required": false,
          "type": "button"
        },
        {
          "text": "Generated from the fields above (same template as the sector). Saves the product first. If your company logo/signature are not set, the DoC is generated without them.",
          "required": false,
          "type": "description"
        },
        {
          "text": "More PPWR data (optional)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Section 1 & 3 - CLASSIFICATION & MINIMISATION (ART 10)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Packaging category",
          "required": false,
          "placeholder": "e-commerce / grouped / transport"
        },
        {
