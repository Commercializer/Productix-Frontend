        },
        {
          "text": "Packaging ratio",
          "required": false
        },
        {
          "text": "Mono-material",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Section 2 - ECONOMIC OPERATOR (ART 15/18)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Manufacturer role",
          "required": false,
          "type": "select",
          "options": [
            "Manufacturer",
            "Importer",
            "Authorised representative"
          ]
        },
        {
          "text": "Unique packaging identifier (Art 15(5))",
          "required": false,
