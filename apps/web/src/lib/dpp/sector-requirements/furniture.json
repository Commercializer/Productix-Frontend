{
  "sector": "FURNITURE",
  "sourceName": "Furniture",
  "sections": {
    "product-identification": {
      "label": "Product identification",
      "fields": [
        {
          "text": "Product name",
          "required": true
        },
        {
          "text": "GTIN-14",
          "required": true,
          "helperText": "14-digit Global Trade Item Number"
        },
        {
          "text": "Sector",
          "required": true
        },
        {
          "text": "Brand name",
          "required": false
        },
        {
          "text": "Model number",
          "required": false
        },
        {
          "text": "Product category",
          "required": false
        },
        {
          "text": "HS Code",
          "required": false
        }
      ]
    },
    "manufacturer-importer": {
      "label": "Manufacturer & importer",
      "fields": [
        {
          "text": "Manufacturer name",
          "required": true
        },
        {
          "text": "Manufacturer country",
          "required": true,
          "type": "country-picker",
          "searchable": true
        },
        {
          "text": "Manufacturer address",
          "required": false
        },
        {
          "text": "Manufacturer contact",
          "required": false
        },
        {
          "text": "Manufacturing facility ID",
          "required": false
        },
        {
          "text": "Manufacturing facility / site",
          "required": false,
          "helperText": "plant code or GS1 GLN). Optional - one of the 4 EU DPP Registry identifiers."
        },
        {
          "text": "Facility ID scheme - None / GLN (GS1) / EU-OP / Other",
          "required": false,
          "helperText": "Optional. Pick GLN only if the Facility ID is a GS1 GLN - it's then validated (13 digits)."
        },
        {
          "text": "Importer name",
          "required": false,
          "helperText": "Required if manufacturer is outside EU",
          "helperTextStyle": "lite"
        },
        {
          "text": "Importer country",
          "required": false,
          "type": "country-picker",
          "searchable": true
        }
      ]
    },
    "product-specifications": {
      "label": "Product specifications",
      "explainerText": "Free-form furniture specifications displayed on the public viewer. Examples: Material · Dimensions · Frame material · Upholstery material · Finish · Color · Weight capacity · Product weight · Assembly required · Recycled content.",
      "explainerText2": "Add the spec rows a consumer would care about. Up to 40 rows.",
      "explainerTextStyle": "lite",
      "maxRows": 40,
      "fields": [
        {
          "text": "Add Spec (Custom rows)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Spec Title",
          "required": false,
          "placeholder": "Frame material"
        },
        {
          "text": "Spec Content",
          "required": false,
          "placeholder": "FSC-certified Oak"
        }
      ]
    },
    "physical-properties": {
      "label": "Physical properties",
      "fields": [
        {
          "text": "Weight (kg)",
          "required": true
        },
        {
          "text": "Width (mm)",
          "required": false
        },
        {
          "text": "Height (mm)",
          "required": false
        },
        {
          "text": "Depth (mm)",
          "required": false
        },
        {
          "text": "Expected lifetime (years)",
          "required": false
        },
        {
          "text": "Warranty (years)",
          "required": false
        },
        {
          "text": "Manufacture date",
          "required": false,
          "type": "date-picker"
        },
        {
          "text": "Expiry date",
          "required": false,
          "type": "date-picker"
        }
      ]
    },
    "furniture-data": {
      "label": "Furniture data",
      "fields": [
        {
          "text": "Furniture data",
          "required": false,
          "type": "section-heading"
        },
        {
          "text": "Category & assembly",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Category",
          "required": true,
          "type": "select",
          "options": [
            "Seating",
            "Table",
            "Cabinet",
            "Bed",
            "Sofa",
            "Shelving",
            "Outdoor",
            "Office",
            "Lighting",
            "Accessory"
          ]
        },
        {
          "text": "Intended use",
          "required": false,
          "type": "select",
          "options": [
            "Residential",
            "Contract",
            "commercial",
            "Outdoor",
            "Kitchen",
            "Bathroom",
            "Healthcare",
            "Educational"
          ]
        },
        {
          "text": "Assembly required",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Assembly time (min)",
          "required": false,
          "placeholder": "25"
        },
        {
          "text": "Flat-pack",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Modular design",
          "required": false,
          "helpertext": "Allows extension / partial replacement",
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Tools required for removal",
          "required": false,
          "placeholder": "Allen key 4 mm, Phillips screwdriver"
        },
        {
          "text": "Wood, panels & EUDR traceability",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Order from highest to lowest %. EUDR Reg. 2023/1115 requires country of origin for solid wood + wood-based panels.",
          "required": false,
          "type": "note"
        },
        {
          "text": "Species",
          "required": false,
          "placeholder": "Oak (Quercus robur)"
        },
        {
          "text": "Share %",
          "required": false,
          "placeholder": "60"
        },
        {
          "text": "Origin",
          "required": false,
          "type": "country-picker",
          "searchable": true
        },
        {
          "text": "FSC",
          "required": false,
          "type": "checkbox"
        },
        {
          "text": "PEFC",
          "required": false,
          "type": "checkbox"
        },
        {
          "text": "FSC ID",
          "required": false,
          "placeholder": "FSC-C012345"
        },
        {
          "text": "Add wood species (Button - New row, above fields again on new wood species)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Panel type",
          "required": false,
          "type": "select",
          "options": [
            "Particleboard",
            "MDF",
            "HDF",
            "OSB",
            "Plywood",
            "Solid wood",
            "Laminate",
            "Veneer",
            "None"
          ]
        },
        {
          "text": "Panel thickness (mm)",
          "required": false,
          "placeholder": "18"
        },
        {
          "text": "FSC chain-of-custody ID",
          "required": false,
          "placeholder": "FSC-C012345"
        },
        {
          "text": "PEFC chain-of-custody ID",
          "required": false,
          "placeholder": "PEFC/04-31-1234"
        },
        {
          "text": "EUDR due-diligence statement URL)",
          "required": false,
          "helperText": "Reg. 2023/1115 (deforestation)"
        },
        {
          "text": "Formaldehyde & chemical emissions",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Formaldehyde class",
          "required": true,
          "type": "select",
          "options": [
            "E0 (≤0.03 ppm)",
            "E0.5",
            "E1 (≤0.1 ppm, EU mandatory)",
            "NAF (No Added Formaldehyde)",
            "F★★★★ (Japan JIS A 1460)",
            "CARB Phase 2 (California)"
          ]
        },
        {
          "text": "Emission (mg/m³)",
          "required": false,
          "placeholder": "0.05",
          "helperText": "EN 16516 chamber test"
        },
        {
          "text": "VOC emission class",
          "required": false,
          "helperText": "FR Décret 2011-321",
          "type": "select",
          "options": [
            "A+ (lowest)",
            "A",
            "B",
            "C (highest)"
          ]
        },
        {
          "text": "Total VOC (mg/m³)",
          "required": false,
          "placeholder": "0.1"
        },
        {
          "text": "Flame-retardants free",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "PFAS-free",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Phthalates-free",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Upholstery & textile components",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Layered upholstery: foam (PUR/HR), fabric, leather, padding. Skip for non-upholstered items (table, shelf).",
          "required": false,
          "type": "note"
        },
        {
          "text": "Layer",
          "required": false,
          "placeholder": "Outer fabric / Padding / Frame"
        },
        {
          "text": "Material",
          "required": false,
          "placeholder": "100% wool, GOTS organic cotton, CMHR PUR foam"
        },
        {
          "text": "Share %",
          "required": false,
          "placeholder": "100%"
        },
        {
          "text": "Add Layer (Button - New row, above fields again on new layer)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Fire-resistance class",
          "required": false,
          "helperText": "UK BS 5852, EN 1021, US CA TB 117",
          "placeholder": "EN 1021-1/-2 cigarette + match"
        },
        {
          "text": "Leather Working Group",
          "required": false,
          "type": "select",
          "options": [
            "Audited",
            "Bronze",
            "Silver",
            "Gold"
          ]
        },
        {
          "text": "Leather origin",
          "required": false,
          "type": "country-picker",
          "searchable": true
        },
        {
          "text": "Durability & test compliance",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Test method",
          "required": false,
          "helperText": "EN 1728 seating, EN 16139 contract, EN 12521 table",
          "placeholder": "EN 1728:2012"
        },
        {
          "text": "Cycles passed",
          "required": false,
          "placeholder": "25000"
        },
        {
          "text": "Load capacity (kg)",
          "required": false,
          "placeholder": "120"
        },
        {
          "text": "Scratch resistance (ISO 2409)",
          "required": false,
          "placeholder": "4.5"
        },
        {
          "text": "Light fastness (Blue wool)",
          "required": false,
          "helperText": "ISO 105-B02 scale 1–8",
          "placeholder": "6"
        },
        {
          "text": "Warranty (years)",
          "required": false,
          "placeholder": "10"
        },
        {
          "text": "Repairability & spare parts",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "FR Repairability Index",
          "required": true,
          "helperText": "1.0–10.0 (Loi AGEC)",
          "placeholder": "8.5"
        },
        {
          "text": "Spare parts availability (years)",
          "required": false,
          "placeholder": "10"
        },
        {
          "text": "Repair kit available",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Repair manual URL",
          "required": false
        },
        {
          "text": "Spare parts URL",
          "required": false
        },
        {
          "text": "Modular replaceable parts",
          "required": false,
          "placeholder": "Seat cushion, armrest, leg, gas cylinder"
        },
        {
          "text": "Recycled content & end-of-life",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Total recycled content (%)",
          "required": false,
          "placeholder": "65"
        },
        {
          "text": "Recycled wood %",
          "required": false,
          "placeholder": "90"
        },
        {
          "text": "Recycled metal %",
          "required": false,
          "placeholder": "85"
        },
        {
          "text": "Recycled plastic %",
          "required": false,
          "placeholder": "30"
        },
        {
          "text": "Recyclability (%)",
          "required": false,
          "placeholder": "92"
        },
        {
          "text": "Disassembly time (minutes)",
          "required": false,
          "placeholder": "15"
        },
        {
          "text": "Disassembly tools",
          "required": false,
          "placeholder": "Allen key 4 mm, Phillips PH2"
        },
        {
          "text": "Take-back URL",
          "required": false
        },
        {
          "text": "Donation / second-hand partner",
          "required": false,
          "placeholder": "IKEA Second Life, Vinted"
        },
        {
          "text": "Environmental footprint",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Carbon footprint per item (kg CO₂)",
          "required": false,
          "placeholder": "42.5"
        },
        {
          "text": "Water footprint per item (L)",
          "required": false,
          "placeholder": "120"
        },
        {
          "text": "Manufacturing energy source",
          "required": false,
          "placeholder": "100% renewable"
        },
        {
          "text": "PEF methodology",
          "required": false,
          "placeholder": "PEFCR Furniture (in development)"
        },
        {
          "text": "PEF declaration URL",
          "required": false
        },
        {
          "text": "Certifications",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "EU Ecolabel licence",
          "required": false,
          "placeholder": "DE/050/001"
        },
        {
          "text": "Blauer Engel ID",
          "required": false,
          "placeholder": "UZ 38"
        },
        {
          "text": "Nordic Swan ID",
          "required": false,
          "placeholder": "3097 0001"
        },
        {
          "text": "GREENGUARD Gold (indoor air)",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Cradle to Cradle",
          "required": false,
          "type": "select",
          "options": [
            "Basic",
            "Bronze",
            "Silver",
            "Gold",
            "Platinum"
          ]
        },
        {
          "text": "ISO 14001 (mfr EMS)",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "BSCI compliant",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        }
      ]
    },
    "substances-of-concern-svhc": {
      "label": "Substances of concern (SVHC)",
      "fields": [
        {
          "text": "Substances of concern (SVHC)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "REACH 1907/2006 · Art. 33 - mandatory if >0.1% w/w (1000 ppm)",
          "required": false,
          "type": "note"
        },
        {
          "text": "Mandatory declaration threshold: >0.1% w/w (1000 ppm) per article. SVHC = Substance of Very High Concern (ECHA Candidate List).",
          "required": false,
          "component": "info_banner",
          "variant": "danger"
        },
        {
          "text": "Substance name",
          "required": false,
          "placeholder": "Cobalt"
        },
        {
          "text": "CAS number",
          "required": false,
          "placeholder": "7440-48-4"
        },
        {
          "text": "Conc. (ppm)",
          "required": false
        },
        {
          "text": "Location in product",
          "required": false,
          "placeholder": "Battery cell"
        },
        {
          "text": "SVHC",
          "required": false,
          "type": "checkbox"
        },
        {
          "text": "Add substance (New row, above fields again on new substance)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Compliance & certifications",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "CE Marking · REACH 1907/2006 · RoHS 2011/65/EU · ESPR 2024/1781",
          "required": false,
          "type": "note"
        },
        {
          "text": "CE marking",
          "required": false,
          "type": "toggle"
        },
        {
          "text": "REACH compliant",
          "required": false,
          "type": "toggle"
        },
        {
          "text": "RoHS compliant",
          "required": false,
          "type": "toggle"
        },
        {
          "text": "Energy efficiency class",
          "required": false,
          "type": "select",
          "options": [
            "A+++",
            "A++",
            "A+",
            "A",
            "B",
            "C",
            "D",
            "E",
            "F",
            "G"
          ]
        },
        {
          "text": "Energy consumption (kWh/year)",
          "required": false
        },
        {
          "text": "IP rating",
          "required": false,
          "placeholder": "IP67",
          "helperText": "IEC 60529"
        },
        {
          "text": "Third party certification",
          "required": false,
          "placeholder": "TÜV · UL · Bureau Veritas"
        }
      ]
    },
    "product-packaging": {
      "label": "Product packaging",
      "fields": [
        {
          "text": "Product packaging",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Packaging & Packaging Waste Regulation (EU) 2025/40 (PPWR) · ESPR 2024/1781. Declare one row per packaging layer.",
          "required": false,
          "type": "note"
        },
        {
          "text": "Layer order",
          "required": false
        },
        {
          "text": "Layer label",
          "required": false,
          "placeholder": "Primary bottle / Outer carton / Transport pallet"
        },
        {
          "text": "Data source",
          "required": false,
          "type": "select",
          "options": [
            "Manual entry",
            "Lookup by GTIN (Productix)",
            "External passport provider link",
            "Packaging layer (from library)"
          ]
        },
        {
          "text": "Packaging layer (from library)",
          "required": false,
          "type": "select",
          "helperText": "Select a shared layer defined via CSV import; referenced, not copied - edit it once and every product using it updates",
          "conditional": {
            "field": "Data source",
            "equals": "Packaging layer (from library)"
          }
        },
        {
          "text": "Packaging GTIN",
          "required": false,
          "conditional": {
            "field": "Data source",
            "equals": "Lookup by GTIN (Productix)"
          }
        },
        {
          "text": "Packaging DPP URL",
          "required": false,
          "placeholder": "https://www.productix.io/01/04796037382921",
          "conditional": {
            "field": "Data source",
            "equals": "External passport provider link"
          }
        },
        {
          "text": "Packaging name",
          "required": false,
          "placeholder": "Brown corrugated carton",
          "conditional": {
            "field": "Data source",
            "equals": "Manual entry"
          }
        },
        {
          "text": "Packaging manufacturer",
          "required": false,
          "placeholder": "EcoPack Industries (Pvt) Ltd",
          "conditional": {
            "field": "Data source",
            "equals": "Manual entry"
          }
        },
        {
          "text": "Packaging manufacturer country",
          "required": false,
          "type": "country-picker",
          "searchable": true,
          "conditional": {
            "field": "Data source",
            "equals": "Manual entry"
          }
        },
        {
          "text": "Required for the Declaration of Conformity",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Layer type (PPWR)",
          "required": false,
          "type": "select",
          "options": [
            "Primary",
            "Secondary",
            "Tertiary"
          ]
        },
        {
          "text": "Weight (g)",
          "required": false,
          "placeholder": "50"
        },
        {
          "text": "Layer composition",
          "required": false,
          "type": "nested-section",
          "helperText": "What this layer is physically made of — one row per material (Ex. bottle body · cap · label).",
          "fields": [
            {
              "text": "Component",
              "required": false,
              "placeholder": "Paper tray"
            },
            {
              "text": "Material",
              "required": true,
              "type": "select",
              "options": [
                "Paper / Cardboard",
                "PET",
                "HDPE",
                "LDPE",
                "PP",
                "PS",
                "Other plastic",
                "Glass",
                "Aluminium",
                "Steel",
                "Wood",
                "Composite",
                "Biopolymer",
                "Other"
              ]
            },
            {
              "text": "Weight (g)",
              "required": false,
              "placeholder": "g"
            },
            {
              "text": "Recycled %",
              "required": false,
              "placeholder": "%"
            }
          ],
          "actions": [
            {
              "text": "Add component (New row on above component fields)",
              "type": "button"
            }
          ]
        },
        {
          "text": "Recyclability grade (Art. 6-11)",
          "required": false,
          "type": "select",
          "options": [
            "A",
            "B",
            "C",
            "Not recyclable"
          ]
        },
        {
          "text": "Reusable",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "EPR registration",
          "required": false,
          "type": "nested-section",
          "helperText": "Extended Producer Responsibility registration(s) - one row per country.",
          "fields": [
            {
              "text": "Country",
              "required": true,
              "type": "country-picker",
              "searchable": true
            },
            {
              "text": "Scheme name",
              "required": true,
              "placeholder": "Scheme name"
            },
            {
              "text": "Registration No.",
              "required": true,
              "placeholder": "Registration No."
            }
          ],
          "actions": [
            {
              "text": "Add EPR registration (New row on above EPR fields)",
              "type": "button"
            }
          ]
        },
        {
          "text": "CONFORMITY & DECLARATION OF CONFORMITY (ART 38/39)",
          "required": false,
          "type": "section-heading"
        },
        {
          "text": "DoC number",
          "required": false,
          "placeholder": "DoC-2026-001"
        },
        {
          "text": "DoC issue date",
          "required": false,
          "type": "date-picker",
          "placeholder": "dd/mm/yyyy"
        },
        {
          "text": "EU DoC exists",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "REACH / SVHC compliant",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Declaration of Conformity URL",
          "required": false,
          "placeholder": "https://..."
        },
        {
          "text": "Upload DoC file",
          "required": false,
          "type": "file-upload"
        },
        {
          "text": "Extract data from DoC",
          "required": false,
          "type": "button"
        },
        {
          "text": "Generate DoC (preview)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Generate + archive DoC",
          "required": false,
