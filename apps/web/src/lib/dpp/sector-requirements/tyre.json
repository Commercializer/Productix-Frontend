        },
        {
          "text": "Updated status",
          "required": false,
          "placeholder": "End-of-life"
        },
        {
          "text": "Date",
          "required": false,
          "type": "date-picker"
        },
        {
          "text": "Serial",
          "required": false,
          "placeholder": "Optional"
        },
        {
          "text": "Evidence URL",
          "required": false
        },
        {
          "text": "Assessed by",
          "required": false
        },
        {
          "text": "Verified by",
          "required": false
        },
        {
          "text": "Sign as Verifiable Credential (offline-verifiable)",
          "required": false,
          "type": "checkbox"
        },
        {
          "text": "Add assessment record (Button)",
          "required": false,
          "type": "button"
        }
      ]
