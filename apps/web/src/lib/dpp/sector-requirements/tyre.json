    "repair-usage-history": {
      "label": "Repair & usage history",
      "fields": [
        {
          "text": "Lifecycle & usage events",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Important usage/lifecycle events (e.g. charge 20%–80%, flooding, emergency shutdown). Event type is free text - no fixed classifiers. GS1 EPCIS 2.0-compatible; machines/IoT can append via the API.",
          "required": false,
          "type": "note"
        },
        {
          "text": "Event type",
          "required": false
        },
        {
          "text": "Serial",
          "required": false
        },
        {
          "text": "From",
          "required": false
        },
        {
          "text": "To",
          "required": false
        },
        {
