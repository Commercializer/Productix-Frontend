{
  "sector": "TYRE",
  "sourceName": "Tyre",
  "sections": {
    "product-identification": {
      "label": "Product identification",
      "fields": [
        {
          "text": "Product name",
          "required": true
        },
        {
          "text": "GTIN-14",
          "required": true,
          "helperText": "14-digit Global Trade Item Number"
        },
        {
          "text": "Sector",
          "required": true
        },
        {
          "text": "Brand name",
          "required": false
        },
        {
          "text": "Model number",
          "required": false
        },
        {
          "text": "Product category",
          "required": false
        },
        {
          "text": "HS Code",
          "required": false
        }
      ]
    },
    "manufacturer-importer": {
      "label": "Manufacturer & importer",
      "fields": [
        {
          "text": "Manufacturer name",
          "required": true
        },
        {
          "text": "Manufacturer country",
          "required": true,
          "type": "country-picker",
          "searchable": true
        },
        {
          "text": "Manufacturer address",
          "required": false
        },
        {
          "text": "Manufacturer contact",
          "required": false
        },
        {
          "text": "Manufacturing facility ID",
          "required": false
        },
        {
          "text": "Manufacturing facility / site",
          "required": false,
          "helperText": "plant code or GS1 GLN). Optional - one of the 4 EU DPP Registry identifiers."
        },
        {
          "text": "Facility ID scheme - None / GLN (GS1) / EU-OP / Other",
          "required": false,
          "helperText": "Optional. Pick GLN only if the Facility ID is a GS1 GLN - it's then validated (13 digits)."
        },
        {
          "text": "Importer name",
          "required": false,
          "helperText": "Required if manufacturer is outside EU",
          "helperTextStyle": "lite"
        },
        {
          "text": "Importer country",
          "required": false,
          "type": "country-picker",
          "searchable": true
        }
      ]
    },
    "product-specifications": {
      "label": "Product specifications",
      "explainerText": "Free-form tyre specifications displayed on the public viewer. Examples: Tyre size · Load index · Speed rating · Tread pattern · Wet grip class · Rolling resistance · Noise level · Tyre type.",
      "explainerText2": "Add the spec rows a consumer would care about. Up to 40 rows.",
      "explainerTextStyle": "lite",
      "maxRows": 40,
      "fields": [
        {
          "text": "Add Spec (Custom rows)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Spec Title",
          "required": false,
          "placeholder": "Tyre size"
        },
        {
          "text": "Spec Content",
          "required": false,
          "placeholder": "225/45 R17"
        }
      ]
    },
    "physical-properties": {
      "label": "Physical properties",
      "fields": [
        {
          "text": "Weight (kg)",
          "required": true
        },
        {
          "text": "Width (mm)",
          "required": false
        },
        {
          "text": "Height (mm)",
          "required": false
        },
        {
          "text": "Depth (mm)",
          "required": false
        },
        {
          "text": "Expected lifetime (years)",
          "required": false
        },
        {
          "text": "Warranty (years)",
          "required": false
        },
        {
          "text": "Manufacture date",
          "required": false,
          "type": "date-picker"
        },
        {
          "text": "Expiry date",
          "required": false,
          "type": "date-picker"
        }
      ]
    },
    "tyre-data": {
      "label": "Tyre data",
      "fields": [
        {
          "text": "Tyre data",
          "required": false,
          "type": "section-heading"
        },
        {
          "text": "EU Tyre Label (Reg. 2020/740)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Vehicle class",
          "required": true,
          "type": "select",
          "options": [
            "C1 - Passenger",
            "C2 - Light truck",
            "C3 - Heavy truck"
          ]
        },
        {
          "text": "Fuel efficiency class",
          "required": false,
          "helperText": "A (lowest rolling resistance) → E",
          "type": "select",
          "options": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ]
        },
        {
          "text": "Wet grip class",
          "required": true,
          "type": "select",
          "options": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ]
        },
        {
          "text": "External noise (dB)",
          "required": false
        },
        {
          "text": "Noise class",
          "required": false,
          "type": "select",
          "options": [
            "A",
            "B",
            "C"
          ]
        },
        {
          "text": "EPREL database ID",
          "required": true,
          "helperText": "Number from eprel.ec.europa.eu/screen/home — auto-creates a 'View on EPREL ↗' link in the public viewer",
          "placeholder": "410099"
        },
        {
          "text": "EU Tyre Label (SVG/PDF/PNG from EPREL)",
          "required": false,
          "type": "upload",
          "helperText": "Optional: upload the official label downloaded from EPREL. Renders as an image at the top of the public viewer."
        },
        {
          "text": "Snow grip (3PMSF)",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Ice grip (Nordic)",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "EV-optimised",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Dimensions & speed/load rating",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Size designation",
          "required": false,
          "placeholder": "205/55 R16 91V"
        },
        {
          "text": "Load index",
          "required": false,
          "placeholder": "91"
        },
        {
          "text": "Speed rating",
          "required": false,
          "placeholder": "V"
        },
        {
          "text": "Tread depth, new (mm)",
          "required": false,
          "placeholder": "7.8"
        },
        {
          "text": "Legal min tread (mm)",
          "required": false,
          "placeholder": "1.6",
          "helperText": "EU C1: 1.6 mm"
        },
        {
          "text": "Tread pattern",
          "required": false,
          "type": "select",
          "options": [
            "Symmetric",
            "Asymmetric",
            "Directional",
            "Semi-slick",
            "Off-road"
          ]
        },
        {
          "text": "Season",
          "required": false,
          "type": "select",
          "options": [
            "Summer",
            "Winter",
            "All-season",
            "All-weather"
          ]
        },
        {
          "text": "Rubber compound & reinforcement",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Typical passenger tyre: 40% NR + 35% SBR + 25% BR. Sum should = 100.",
          "required": false,
          "type": "note"
        },
        {
          "text": "Polymer",
          "required": false,
          "placeholder": "Natural rubber (NR)"
        },
        {
          "text": "Share %",
          "required": false,
          "placeholder": "40"
        },
        {
          "text": "Add Polymer (Button - New row, above fields again on new polymer)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Carbon black %",
          "required": false,
          "placeholder": "22"
        },
        {
          "text": "Silica %",
          "required": false,
          "placeholder": "14"
        },
        {
          "text": "Steel belt %",
          "required": false,
          "placeholder": "12"
        },
        {
          "text": "Textile cord %",
          "required": false,
          "placeholder": "5"
        },
        {
          "text": "Bead wire type",
          "required": false,
          "placeholder": "Brass-plated steel 0.96 mm"
        },
        {
          "text": "Recycled rubber %",
          "required": false,
          "placeholder": "3.5"
        },
        {
          "text": "Bio-based content %",
          "required": false,
          "placeholder": "2.5"
        },
        {
          "text": "High-aromatic oils free",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Tyre abrasion & microplastic emissions",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "UTQG treadwear",
          "required": false,
          "placeholder": "540"
        },
        {
          "text": "Abrasion (mg/km)",
          "required": false,
          "placeholder": "90",
          "helperText": "UNECE GRBP draft"
        },
        {
          "text": "Anticipated abrasion class",
          "required": false,
          "type": "select",
          "options": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ]
        },
        {
          "text": "Test method",
          "required": false,
          "placeholder": "UNECE GRBP-2025 drum test"
        },
        {
          "text": "Manufacturing & DOT traceability",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Country of manufacture (Country picker search and select)",
          "required": false,
          "type": "country-picker",
          "searchable": true
        },
        {
          "text": "Factory ID (DOT plant code)",
          "required": false,
          "placeholder": "B9"
        },
        {
          "text": "Manufacture week/year",
          "required": false,
          "placeholder": "2526"
        },
        {
          "text": "Full DOT code",
          "required": false,
          "placeholder": "DOT B9 H1 ABCD 2526"
        },
        {
          "text": "End-of-life",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Retreadable",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Recycling pathway",
          "required": false,
          "type": "select",
          "options": [
            "Mechanical (crumb)",
            "Devulcanisation",
            "Pyrolysis",
            "Energy recovery",
            "Retread first",
            "Not recyclable"
          ]
        },
        {
          "text": "Collection partner (PRO)",
          "required": false,
          "placeholder": "Eltma SAS"
        },
        {
          "text": "Retread pathway URL",
          "required": false
        },
        {
          "text": "Performance & safety extras",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Run-flat",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Self-sealing",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Studdable",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Homologation codes",
          "required": false,
          "placeholder": "E11 R30 + R117 (Type-Approval)"
        }
      ]
    },
    "substances-of-concern-svhc": {
      "label": "Substances of concern (SVHC)",
      "fields": [
        {
          "text": "Substances of concern (SVHC)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "REACH 1907/2006 · Art. 33 - mandatory if >0.1% w/w (1000 ppm)",
          "required": false,
          "type": "note"
        },
        {
          "text": "Mandatory declaration threshold: >0.1% w/w (1000 ppm) per article. SVHC = Substance of Very High Concern (ECHA Candidate List).",
          "required": false,
          "component": "info_banner",
          "variant": "danger"
        },
        {
          "text": "Substance name",
          "required": false,
          "placeholder": "Cobalt"
        },
        {
          "text": "CAS number",
          "required": false,
          "placeholder": "7440-48-4"
        },
        {
          "text": "Conc. (ppm)",
          "required": false
        },
        {
          "text": "Location in product",
          "required": false,
          "placeholder": "Battery cell"
        },
        {
          "text": "SVHC",
          "required": false,
          "type": "checkbox"
        },
        {
          "text": "Add substance (New row, above fields again on new substance)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Compliance & certifications",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "CE Marking · REACH 1907/2006 · RoHS 2011/65/EU · ESPR 2024/1781",
          "required": false,
          "type": "note"
        },
        {
          "text": "CE marking",
          "required": false,
          "type": "toggle"
        },
        {
          "text": "REACH compliant",
          "required": false,
          "type": "toggle"
        },
        {
          "text": "RoHS compliant",
          "required": false,
          "type": "toggle"
        },
        {
          "text": "Energy efficiency class",
          "required": false,
          "type": "select",
          "options": [
            "A+++",
            "A++",
            "A+",
            "A",
            "B",
            "C",
            "D",
            "E",
            "F",
            "G"
          ]
        },
        {
          "text": "Energy consumption (kWh/year)",
          "required": false
        },
        {
          "text": "IP rating",
          "required": false,
          "placeholder": "IP67",
          "helperText": "IEC 60529"
        },
        {
          "text": "Third party certification",
          "required": false,
          "placeholder": "TÜV · UL · Bureau Veritas"
        }
      ]
    },
    "product-packaging": {
      "label": "Product packaging",
      "fields": [
        {
          "text": "Product packaging",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Packaging & Packaging Waste Regulation (EU) 2025/40 (PPWR) · ESPR 2024/1781. Declare one row per packaging layer.",
          "required": false,
          "type": "note"
        },
        {
          "text": "Layer order",
          "required": false
        },
        {
          "text": "Layer label",
          "required": false,
          "placeholder": "Primary bottle / Outer carton / Transport pallet"
        },
        {
          "text": "Data source",
          "required": false,
          "type": "select",
          "options": [
            "Manual entry",
            "Lookup by GTIN (Productix)",
            "External passport provider link",
            "Packaging layer (from library)"
          ]
        },
        {
          "text": "Packaging layer (from library)",
          "required": false,
          "type": "select",
          "helperText": "Select a shared layer defined via CSV import; referenced, not copied - edit it once and every product using it updates",
          "conditional": {
            "field": "Data source",
            "equals": "Packaging layer (from library)"
          }
        },
        {
          "text": "Packaging GTIN",
          "required": false,
          "conditional": {
            "field": "Data source",
            "equals": "Lookup by GTIN (Productix)"
          }
        },
        {
          "text": "Packaging DPP URL",
          "required": false,
          "placeholder": "https://www.productix.io/01/04796037382921",
          "conditional": {
            "field": "Data source",
            "equals": "External passport provider link"
          }
        },
        {
          "text": "Packaging name",
          "required": false,
          "placeholder": "Brown corrugated carton",
          "conditional": {
            "field": "Data source",
            "equals": "Manual entry"
          }
        },
        {
          "text": "Packaging manufacturer",
          "required": false,
          "placeholder": "EcoPack Industries (Pvt) Ltd",
          "conditional": {
            "field": "Data source",
            "equals": "Manual entry"
          }
        },
        {
          "text": "Packaging manufacturer country",
          "required": false,
          "type": "country-picker",
          "searchable": true,
          "conditional": {
            "field": "Data source",
            "equals": "Manual entry"
          }
        },
        {
          "text": "Required for the Declaration of Conformity",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Layer type (PPWR)",
          "required": false,
          "type": "select",
          "options": [
            "Primary",
            "Secondary",
            "Tertiary"
          ]
        },
        {
          "text": "Weight (g)",
          "required": false,
          "placeholder": "50"
        },
        {
          "text": "Layer composition",
          "required": false,
          "type": "nested-section",
          "helperText": "What this layer is physically made of — one row per material (Ex. bottle body · cap · label).",
          "fields": [
            {
              "text": "Component",
              "required": false,
              "placeholder": "Paper tray"
            },
            {
              "text": "Material",
              "required": true,
              "type": "select",
              "options": [
                "Paper / Cardboard",
                "PET",
                "HDPE",
                "LDPE",
                "PP",
                "PS",
                "Other plastic",
                "Glass",
                "Aluminium",
                "Steel",
                "Wood",
                "Composite",
                "Biopolymer",
                "Other"
              ]
            },
            {
              "text": "Weight (g)",
              "required": false,
              "placeholder": "g"
            },
            {
              "text": "Recycled %",
              "required": false,
              "placeholder": "%"
            }
          ],
          "actions": [
            {
              "text": "Add component (New row on above component fields)",
              "type": "button"
            }
          ]
        },
        {
          "text": "Recyclability grade (Art. 6-11)",
          "required": false,
          "type": "select",
          "options": [
            "A",
            "B",
            "C",
            "Not recyclable"
          ]
        },
        {
          "text": "Reusable",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "EPR registration",
          "required": false,
          "type": "nested-section",
          "helperText": "Extended Producer Responsibility registration(s) - one row per country.",
          "fields": [
            {
              "text": "Country",
              "required": true,
              "type": "country-picker",
              "searchable": true
            },
            {
              "text": "Scheme name",
              "required": true,
              "placeholder": "Scheme name"
            },
            {
              "text": "Registration No.",
              "required": true,
              "placeholder": "Registration No."
            }
          ],
          "actions": [
            {
              "text": "Add EPR registration (New row on above EPR fields)",
              "type": "button"
            }
          ]
        },
        {
          "text": "CONFORMITY & DECLARATION OF CONFORMITY (ART 38/39)",
          "required": false,
          "type": "section-heading"
        },
        {
          "text": "DoC number",
          "required": false,
          "placeholder": "DoC-2026-001"
        },
        {
          "text": "DoC issue date",
          "required": false,
          "type": "date-picker",
          "placeholder": "dd/mm/yyyy"
        },
        {
          "text": "EU DoC exists",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "REACH / SVHC compliant",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Declaration of Conformity URL",
          "required": false,
          "placeholder": "https://..."
        },
        {
          "text": "Upload DoC file",
          "required": false,
          "type": "file-upload"
        },
        {
          "text": "Extract data from DoC",
          "required": false,
          "type": "button"
        },
        {
          "text": "Generate DoC (preview)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Generate + archive DoC",
          "required": false,
          "type": "button"
        },
        {
          "text": "Generated from the fields above (same template as the sector). Saves the product first. If your company logo/signature are not set, the DoC is generated without them.",
          "required": false,
          "type": "description"
        },
        {
          "text": "Save layer",
          "required": false,
          "type": "button"
        }
      ]
    },
    "end-of-life": {
      "label": "End of life",
      "fields": [
        {
          "text": "End of life",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "ESPR 2024/1781 · Art. 7(2)(f) · Waste Framework Directive 2008/98/EC",
          "required": false,
          "type": "note"
        },
        {
          "text": "EU waste code (EWC)",
