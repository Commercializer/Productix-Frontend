{
  "sector": "FOOD",
  "sourceName": "Food & Beverage",
  "sections": {
    "product-identification": {
      "label": "Product identification",
      "fields": [
        {
          "text": "Product name",
          "required": true
        },
        {
          "text": "GTIN-14",
          "required": true,
          "helperText": "14-digit Global Trade Item Number"
        },
        {
          "text": "Sector",
          "required": true
        },
        {
          "text": "Brand name",
          "required": false
        },
        {
          "text": "Product category",
          "required": false
        },
        {
          "text": "HS Code",
          "required": false
        }
      ]
    },
    "manufacturer-importer": {
      "label": "Manufacturer & importer",
      "fields": [
        {
          "text": "Manufacturer name",
          "required": true
        },
        {
          "text": "Manufacturer country",
          "required": true,
          "type": "country-picker",
          "searchable": true
        },
        {
          "text": "Manufacturer address",
          "required": false
        },
        {
          "text": "Manufacturer contact",
          "required": false
        },
        {
          "text": "Manufacturing facility ID",
          "required": false
        },
        {
          "text": "Manufacturing facility / site",
          "required": false,
          "helperText": "plant code or GS1 GLN). Optional - one of the 4 EU DPP Registry identifiers."
        },
        {
          "text": "Facility ID scheme - None / GLN (GS1) / EU-OP / Other",
          "required": false,
          "helperText": "Optional. Pick GLN only if the Facility ID is a GS1 GLN - it's then validated (13 digits)."
        },
        {
          "text": "Importer name",
          "required": false,
          "helperText": "Required if manufacturer is outside EU",
          "helperTextStyle": "lite"
        },
        {
          "text": "Importer country",
          "required": false,
          "type": "country-picker",
          "searchable": true
        }
      ]
    },
    "product-specifications": {
      "label": "Product specifications",
      "explainerText": "Free-form commercial info shown on the public viewer. Examples: Volume · Flavour · Packaging format · Serving size · Country of origin.",
      "explainerText2": "Add the spec rows a consumer would care about. Up to 40 rows.",
      "explainerTextStyle": "lite",
      "maxRows": 40,
      "fields": [
        {
          "text": "Add Spec (Custom rows)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Field Title",
          "required": false,
          "placeholder": "Volume"
        },
        {
          "text": "Field Content",
          "required": false,
          "placeholder": "500 ml, Sparkling"
        }
      ]
    },
    "physical-properties": {
      "label": "Physical properties",
      "fields": [
        {
          "text": "Weight (kg)",
          "required": true
        },
        {
          "text": "Width (mm)",
          "required": false
        },
        {
          "text": "Height (mm)",
          "required": false
        },
        {
          "text": "Depth (mm)",
          "required": false
        }
      ]
    },
    "food-product-data": {
      "label": "Food & Beverage product data",
      "mainTitle": "Food & Beverage",
      "showMainTitleOnAllSubsections": true,
      "fields": [
        {
          "text": "Identification",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Food category",
          "required": false,
          "type": "select",
          "options": [
            "Beverage",
            "Dairy",
            "Bakery",
            "Confectionery",
            "Meat",
            "Fish & seafood",
            "Fruit & vegetables",
            "Cereal & grains",
            "Snacks",
            "Condiment & sauce",
            "Frozen",
            "Supplement",
            "Other"
          ]
        },
        {
          "text": "Legal name - not brand (Art 17)",
          "required": true
        },
        {
          "text": "Net quantity",
          "required": true
        },
        {
          "text": "Food business operator",
          "required": false
        },
        {
          "text": "Operator address",
          "required": false
        },
        {
          "text": "Ingredients & allergens",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Ingredient list",
          "required": true,
          "helperText": "descending order of weight",
          "helperTextStyle": "lite",
          "placeholder": "Tomatoes (148g per 100g), vinegar, sugar, salt, spices..."
        },
        {
          "text": "QUID - emphasised ingredients (%)",
          "required": false,
          "type": "custom-rows",
          "rowFields": [
            {
              "text": "Ingredient",
              "required": false
            },
            {
              "text": "%",
              "required": false
            }
          ]
        },
        {
          "text": "Add ingredient",
          "required": false,
          "type": "button"
        },
        {
          "text": "Allergens (of 14)",
          "required": true,
          "helperText": "Annex II"
        },
        {
          "text": "Contains GMO",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Additives (E-numbers)",
          "required": false,
          "placeholder": "E330, E300"
        },
        {
          "text": "Nutrition declaration",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Basis",
          "required": false,
          "type": "select",
          "options": [
            "per 100g",
            "per 100 ml"
          ]
        },
        {
          "text": "Nutri-Score",
          "required": false,
          "type": "select",
          "options": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ]
        },
        {
          "text": "Energy (kJ)",
          "required": false
        },
        {
          "text": "Energy (kcal)",
          "required": true
        },
        {
          "text": "Fat (g)",
          "required": false
        },
        {
          "text": "of which saturates (g)",
          "required": false
        },
        {
          "text": "Carbohydrate (g)",
          "required": false
        },
        {
          "text": "of which sugars (g)",
          "required": false
        },
        {
          "text": "Fibre (g)",
          "required": false
        },
        {
          "text": "Protein (g)",
          "required": false
        },
        {
          "text": "Salt (g)",
          "required": false
        },
        {
          "text": "Dates & storage",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Durability type",
          "required": false,
          "type": "select",
          "options": [
            "Best before",
            "Use by"
          ]
        },
        {
          "text": "Date",
          "required": false,
          "type": "date-picker"
        },
        {
          "text": "Min. durability from production (days)",
          "required": false
        },
        {
          "text": "Lot number",
          "required": false
        },
        {
          "text": "Storage conditions",
          "required": false,
          "placeholder": "Store in a cool, dry place. Refrigerate after opening."
        },
        {
          "text": "Preparation instructions",
          "required": false
        },
        {
          "text": "Claims & diet",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Organic certified",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Organic cert. number",
          "required": false,
          "placeholder": "SK-BIO-003"
        },
        {
          "text": "Vegan",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Vegetarian",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Gluten-free",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Halal",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Kosher",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Nutrition claims",
          "required": false,
          "placeholder": "High in fibre · Source of protein"
        },
        {
          "text": "Origin & traceability",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Place of provenance",
          "required": false
        },
        {
          "text": "Primary ingredient origin",
          "required": false
        },
        {
          "text": "Environmental & certifications",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Certifications",
          "required": false,
          "placeholder": "Fairtrade, PDO"
        },
        {
          "text": "Quality & sustainability certifications",
          "required": false,
          "type": "tags",
          "multiple": true,
          "options": [
            "ISO 22000",
            "HACCP",
            "IFS Food",
            "BRCGS",
            "FSSC 22000",
            "BIO / Organic",
            "Fairtrade",
            "Rainforest Alliance",
            "MSC",
            "ASC",
            "RSPO",
            "Halal",
            "Kosher",
            "Other"
          ],
          "helperText": "Select all that apply, or leave empty.",
          "helperTextStyle": "lite"
        }
      ]
    },
    "product-packaging": {
      "label": "Product packaging",
      "fields": [
        {
          "text": "Product packaging",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Packaging & Packaging Waste Regulation (EU) 2025/40 (PPWR) · ESPR 2024/1781. Declare one row per packaging layer.",
          "required": false,
          "type": "note"
        },
        {
          "text": "Layer order",
          "required": false
        },
        {
          "text": "Layer label",
          "required": false,
          "placeholder": "Primary bottle / Outer carton / Transport pallet"
        },
        {
          "text": "Data source",
          "required": false,
          "type": "select",
          "options": [
            "Manual entry",
            "Lookup by GTIN (Productix)",
            "External passport provider link",
            "Packaging layer (from library)"
          ]
        },
        {
          "text": "Packaging layer (from library)",
          "required": false,
          "type": "select",
          "helperText": "Select a shared layer defined via CSV import; referenced, not copied - edit it once and every product using it updates",
          "conditional": {
            "field": "Data source",
            "equals": "Packaging layer (from library)"
          }
        },
        {
          "text": "Packaging GTIN",
          "required": false,
          "conditional": {
            "field": "Data source",
            "equals": "Lookup by GTIN (Productix)"
          }
        },
        {
          "text": "Packaging DPP URL",
          "required": false,
          "placeholder": "https://www.productix.io/01/04796037382921",
          "conditional": {
            "field": "Data source",
            "equals": "External passport provider link"
          }
        },
        {
          "text": "Packaging name",
          "required": false,
          "placeholder": "Brown corrugated carton",
          "conditional": {
            "field": "Data source",
            "equals": "Manual entry"
          }
        },
        {
          "text": "Packaging manufacturer",
          "required": false,
          "placeholder": "EcoPack Industries (Pvt) Ltd",
          "conditional": {
            "field": "Data source",
            "equals": "Manual entry"
          }
        },
        {
          "text": "Packaging manufacturer country",
          "required": false,
          "type": "country-picker",
          "searchable": true,
          "conditional": {
            "field": "Data source",
            "equals": "Manual entry"
          }
        },
        {
          "text": "Required for the Declaration of Conformity",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Layer type (PPWR)",
          "required": false,
          "type": "select",
          "options": [
            "Primary",
            "Secondary",
            "Tertiary"
          ]
        },
        {
          "text": "Weight (g)",
          "required": false,
          "placeholder": "50"
        },
        {
          "text": "Layer composition",
          "required": false,
          "type": "nested-section",
          "helperText": "What this layer is physically made of — one row per material (Ex. bottle body · cap · label).",
          "fields": [
            {
              "text": "Component",
              "required": false,
              "placeholder": "Paper tray"
            },
            {
              "text": "Material",
              "required": true,
              "type": "select",
              "options": [
                "Paper / Cardboard",
                "PET",
                "HDPE",
                "LDPE",
                "PP",
                "PS",
                "Other plastic",
                "Glass",
                "Aluminium",
                "Steel",
                "Wood",
                "Composite",
                "Biopolymer",
                "Other"
              ]
            },
            {
              "text": "Weight (g)",
              "required": false,
              "placeholder": "g"
            },
            {
              "text": "Recycled %",
              "required": false,
              "placeholder": "%"
            }
          ],
          "actions": [
            {
              "text": "Add component (New row on above component fields)",
              "type": "button"
            }
          ]
        },
        {
          "text": "Recyclability grade (Art. 6-11)",
          "required": false,
          "type": "select",
          "options": [
            "A",
            "B",
            "C",
            "Not recyclable"
          ]
        },
        {
          "text": "Reusable",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "EPR registration",
          "required": false,
          "type": "nested-section",
          "helperText": "Extended Producer Responsibility registration(s) - one row per country.",
          "fields": [
            {
              "text": "Country",
              "required": true,
              "type": "country-picker",
              "searchable": true
            },
            {
              "text": "Scheme name",
              "required": true,
              "placeholder": "Scheme name"
            },
            {
              "text": "Registration No.",
              "required": true,
              "placeholder": "Registration No."
            }
          ],
          "actions": [
            {
              "text": "Add EPR registration (New row on above EPR fields)",
              "type": "button"
            }
          ]
        },
        {
          "text": "CONFORMITY & DECLARATION OF CONFORMITY (ART 38/39)",
          "required": false,
          "type": "section-heading"
        },
        {
          "text": "DoC number",
          "required": false,
          "placeholder": "DoC-2026-001"
        },
        {
          "text": "DoC issue date",
          "required": false,
          "type": "date-picker",
          "placeholder": "dd/mm/yyyy"
        },
        {
          "text": "EU DoC exists",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "REACH / SVHC compliant",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Declaration of Conformity URL",
          "required": false,
          "placeholder": "https://..."
        },
        {
          "text": "Upload DoC file",
          "required": false,
          "type": "file-upload"
        },
        {
          "text": "Extract data from DoC",
          "required": false,
          "type": "button"
        },
        {
          "text": "Generate DoC (preview)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Generate + archive DoC",
          "required": false,
          "type": "button"
        },
        {
          "text": "Generated from the fields above (same template as the sector). Saves the product first. If your company logo/signature are not set, the DoC is generated without them.",
          "required": false,
          "type": "description"
        },
        {
          "text": "Save layer",
          "required": false,
          "type": "button"
        }
      ]
    },
    "product-gallery": {
      "label": "Product gallery",
      "fields": [
        {
          "text": "Product gallery",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Product images shown on the public DPP page. Upload up to 10 MB per image; set one image as primary. Drag to reorder.",
          "required": false,
          "type": "note"
        },
        {
          "text": "Image (Upload, max 10 MB)",
          "required": false,
          "type": "upload"
        },
        {
          "text": "Set as primary (Button)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Delete image (Button)",
          "required": false,
          "type": "button"
        }
      ]
    },
    "documents-links": {
      "label": "Documents & links",
      "fields": [
        {
          "text": "DoC",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Generate the EU Declaration of Conformity from this product's data, in the languages you choose. Saved PDFs appear under the Documents sub-section (visible to authorities only).",
          "required": false,
          "type": "note"
        },
        {
          "text": "Preview DoC (Button)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Download (Word) (Button)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Generate & save DoC (Button)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Documents",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "HACCP plan",
          "required": false,
          "type": "upload"
        },
        {
          "text": "ISO 22000 certificate",
          "required": false,
          "type": "upload"
        },
        {
          "text": "IFS Food certificate",
          "required": false,
          "type": "upload"
        },
        {
          "text": "BRCGS certificate",
          "required": false,
          "type": "upload"
        },
        {
          "text": "FSSC 22000 certificate",
          "required": false,
          "type": "upload"
        },
        {
          "text": "Allergen declaration",
          "required": false,
          "type": "upload"
        },
        {
          "text": "Nutrition / lab analysis",
          "required": false,
          "type": "upload"
        },
        {
          "text": "Product specification",
          "required": false,
          "type": "upload"
        },
        {
          "text": "Sustainability certificate",
          "required": false,
          "type": "upload"
        },
        {
          "text": "Other documents",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Any additional document not covered above (e.g. warranty, conformity annex, spec sheet).",
          "required": false,
          "type": "note"
        },
        {
          "text": "Add document (custom documents upload option)",
          "required": false,
          "type": "upload"
        },
        {
          "text": "Links",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Repair manual URL",
          "required": false
        },
        {
          "text": "Repair network URL",
          "required": false
        },
        {
          "text": "Spare parts URL",
          "required": false
        },
        {
          "text": "Disassembly instructions URL",
          "required": false
        }
      ]
    },
    "version": {
      "label": "Version",
      "fields": [
        {
          "text": "Version history",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Every publish creates a new immutable, digitally-signed version shown to customers. Compare changes against the previous version, verify the signature (offline-verifiable Verifiable Credential), and review the audit trail.",
          "required": false,
          "type": "note"
        },
        {
          "text": "Version number",
          "required": false
        },
        {
          "text": "Effective from",
          "required": false
        },
        {
          "text": "Effective to",
          "required": false
        },
        {
          "text": "Change type",
          "required": false
        },
        {
          "text": "Note",
          "required": false
        },
        {
          "text": "Published by",
          "required": false
        },
        {
          "text": "View changes / diff (Button)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Verify signature (Button)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Publish new version (Button)",
          "required": false,
          "type": "button"
        }
      ]
    }
  }
}
