{
  "sector": "PACKAGING",
  "sourceName": "Packaging",
  "sections": {
    "product-identification": {
      "label": "Product identification",
      "fields": [
        {
          "text": "Product name",
          "required": true
        },
        {
          "text": "GTIN-14",
          "required": true,
          "helperText": "14-digit Global Trade Item Number"
        },
        {
          "text": "Sector",
          "required": true
        },
        {
          "text": "Brand name",
          "required": false
        },
        {
          "text": "Product category",
          "required": false
        },
        {
          "text": "HS Code",
          "required": false
        }
      ]
    },
    "manufacturer-importer": {
      "label": "Manufacturer & importer",
      "fields": [
        {
          "text": "Manufacturer name",
          "required": true
        },
        {
          "text": "Manufacturer country",
          "required": true,
          "type": "country-picker",
          "searchable": true
        },
        {
          "text": "Manufacturer address",
          "required": false
        },
        {
          "text": "Manufacturer contact",
          "required": false
        },
        {
          "text": "Manufacturing facility ID",
          "required": false
        },
        {
          "text": "Manufacturing facility / site",
          "required": false,
          "helperText": "plant code or GS1 GLN). Optional - one of the 4 EU DPP Registry identifiers."
        },
        {
          "text": "Facility ID scheme - None / GLN (GS1) / EU-OP / Other",
          "required": false,
          "helperText": "Optional. Pick GLN only if the Facility ID is a GS1 GLN - it's then validated (13 digits)."
        },
        {
          "text": "Importer name",
          "required": false,
          "helperText": "Required if manufacturer is outside EU",
          "helperTextStyle": "lite"
        },
        {
          "text": "Importer country",
          "required": false,
          "type": "country-picker",
          "searchable": true
        }
      ]
    },
    "product-specifications": {
      "label": "Product specifications",
      "explainerText": "Free-form packaging specifications displayed on the public viewer. Examples: Packaging type · Material · Dimensions · Weight · Capacity · Recycled content · Recyclability · Barrier properties · Closure type · Food-contact suitability · Printing method.",
      "explainerText2": "Add the spec rows a consumer would care about. Up to 40 rows.",
      "explainerTextStyle": "lite",
      "maxRows": 40,
      "fields": [
        {
          "text": "Add Spec (Custom rows)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Spec Title",
          "required": false,
          "placeholder": "Packaging type"
        },
        {
          "text": "Spec Content",
          "required": false,
          "placeholder": "Flexible Stand-Up Pouch"
        }
      ]
    },
    "physical-properties": {
      "label": "Physical properties",
      "fields": [
        {
          "text": "Weight (kg)",
          "required": true
        },
        {
          "text": "Width (mm)",
          "required": false
        },
        {
          "text": "Height (mm)",
          "required": false
        },
        {
          "text": "Depth (mm)",
          "required": false
        },
        {
          "text": "Expected lifetime (years)",
          "required": false
        },
        {
          "text": "Warranty (years)",
          "required": false
        },
        {
          "text": "Manufacture date",
          "required": false,
          "type": "date-picker"
        },
        {
          "text": "Expiry date",
          "required": false,
          "type": "date-picker"
        }
      ]
    },
    "packaging-data": {
      "label": "Packaging data",
      "fields": [
        {
          "text": "Packaging data",
          "required": false,
          "type": "section-heading"
        },
        {
          "text": "Classification",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Category",
          "required": false,
          "type": "select",
          "options": [
            "Plastic — rigid",
            "Plastic — flexible",
            "Paper / board",
            "Glass",
            "Metal — aluminium",
            "Metal — steel",
            "Composite",
            "Wood",
            "Textile",
            "Ceramic",
            "Biopolymer",
            "Other"
          ]
        },
        {
          "text": "Format",
          "required": false,
          "placeholder": "bottle",
          "helperText": "bottle / box / pouch / can / film"
        },
        {
          "text": "Packaging level",
          "required": false,
          "type": "select",
          "options": [
            "Primary (sales)",
            "Secondary (grouped)",
            "Tertiary (transport)",
            "Service",
            "Transport",
            "Grouped"
          ]
        },
        {
          "text": "Single-use",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Reusable",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Mono-material",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ],
          "helperText": "Single material = easiest to recycle"
        },
        {
          "text": "Intended use",
          "required": false,
          "type": "text",
          "placeholder": "Describe the intended use of the packaging"
        },
        {
          "text": "Economic operators (PPWR Art 15 / 18)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Identification that must appear on the packaging from 12 Aug 2026. A GS1 Digital Link satisfies the Art 15(5) identifier and may carry the Art 15(6) producer identification.",
          "required": false,
          "type": "note"
        },
        {
          "text": "Producer name (Art 15(6))",
          "required": true,
          "placeholder": "Demo Packaging Co."
        },
        {
          "text": "Producer trademark",
          "required": true,
          "placeholder": "AquaPure"
        },
        {
          "text": "Unique packaging identifier (Art 15(5))",
          "required": true,
          "placeholder": "EPR reg number, GLN or others",
          "helperText": "Unique packaging ID on the pack from 12 Aug 2026 - EPR registration no., GLN, or your own code"
        },
        {
          "text": "Producer address(Art 15(6))",
          "required": true,
          "placeholder": "Priemyselná 12, 821 09 Bratislava, Slovakia"
        },
        {
          "text": "Importer name (Art 18)",
          "required": false
        },
        {
          "text": "Importer trademark",
          "required": false
        },
        {
          "text": "Importer address",
          "required": false
        },
        {
          "text": "Material composition (Art 10 / 12)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Component",
          "required": false,
          "placeholder": "PET bottle"
        },
        {
          "text": "Material",
          "required": false,
          "placeholder": "rPET (recycled PET)"
        },
        {
          "text": "Weight (g)",
          "required": false,
          "placeholder": "22.5"
        },
        {
          "text": "Share (%)",
          "required": false,
          "placeholder": "25"
        },
        {
          "text": "Recycled %",
          "required": false,
          "placeholder": "100"
        },
        {
          "text": "Color",
          "required": false,
          "placeholder": "clear"
        },
        {
          "text": "Rec",
          "required": false,
          "type": "checkbox"
        },
        {
          "text": "Add material (New row, above fields again on new material)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Total weight (g)",
          "required": false,
          "placeholder": "25.4"
        },
        {
          "text": "Empty weight (g)",
          "required": false,
          "placeholder": "25.4"
        },
        {
          "text": "Packaging ratio",
          "required": false,
          "placeholder": "0.05",
          "helperText": "packaging mass ÷ product mass (Art 10)"
        },
        {
          "text": "Substances (PPWR Art 5)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "I confirm that the total fluorine content of the packaging does not exceed the legal limit of 50 ppm.",
          "required": false,
          "type": "checkbox"
        },
        {
          "type": "info-banner",
          "variant": "neutral",
          "title": "Substance status (declared under the legal limits)",
          "items": [
            "Total fluorine (ppm): ≤ 50 ppm",
            "PFAS: No · under limit",
            "Heavy metals Σ (mg/kg): ≤ 100 mg/kg",
            "SVHC: None above 0.1% (1000 ppm)"
          ]
        },
        {
          "text": "Total fluorine (ppm)",
          "required": true,
          "type": "select",
          "options": [
            "Not detected",
            "≤ 50 ppm",
            "> 50 ppm"
          ]
        },
        {
          "text": "Measured value (ppm)",
          "required": true,
          "placeholder": "120",
          "helperText": "> 50",
          "conditional": {
            "field": "Total fluorine (ppm)",
            "equals": "> 50 ppm"
          }
        },
        {
          "text": "Food contact",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "PFAS individual (ppb)",
          "required": false,
          "placeholder": "0",
          "helperText": "Limit 25 food-contact",
          "disabledWhen": {
            "field": "Food contact",
            "equals": "No"
          },
          "requiredWhen": {
            "field": "Food contact",
            "equals": "Yes"
          }
        },
        {
          "text": "PFAS sum (ppb)",
          "required": false,
          "placeholder": "0",
          "helperText": "Limit 250",
          "disabledWhen": {
            "field": "Food contact",
            "equals": "No"
          },
          "requiredWhen": {
            "field": "Food contact",
            "equals": "Yes"
          }
        },
        {
          "text": "PFAS free",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Heavy metals Σ (mg/kg)",
          "required": true,
          "placeholder": "8",
          "helperText": "Pb+Cd+Hg+CrVI ≤ 100"
        },
        {
          "text": "Bisphenol free",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Substances of concern (SVHC)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "I confirm that the packaging does not contain SVHC (Substances of Very High Concern) above the mandatory notification limit of 0.1% by weight (1000 ppm).",
          "required": true,
          "type": "checkbox"
        },
        {
          "text": "SVHC name",
          "required": true,
          "placeholder": "DEHP",
          "conditional": {
            "field": "I confirm that the packaging does not contain SVHC (Substances of Very High Concern) above the mandatory notification limit of 0.1% by weight (1000 ppm).",
            "equals": false
          }
        },
        {
          "text": "CAS / EC",
          "required": true,
          "placeholder": "117-81-7",
          "conditional": {
            "field": "I confirm that the packaging does not contain SVHC (Substances of Very High Concern) above the mandatory notification limit of 0.1% by weight (1000 ppm).",
            "equals": false
          }
        },
        {
          "text": "Concentration",
          "required": true,
          "placeholder": "0.2% / 2000 ppm",
          "conditional": {
            "field": "I confirm that the packaging does not contain SVHC (Substances of Very High Concern) above the mandatory notification limit of 0.1% by weight (1000 ppm).",
            "equals": false
          }
        },
        {
          "text": "Safety instructions",
          "required": false,
          "placeholder": "",
          "conditional": {
            "field": "I confirm that the packaging does not contain SVHC (Substances of Very High Concern) above the mandatory notification limit of 0.1% by weight (1000 ppm).",
            "equals": false
          }
        },
        {
          "text": "Supporting doc / lab report",
          "required": false,
          "placeholder": "https://...",
          "conditional": {
            "field": "I confirm that the packaging does not contain SVHC (Substances of Very High Concern) above the mandatory notification limit of 0.1% by weight (1000 ppm).",
            "equals": false
          }
        },
        {
          "text": "Add SVHC substance ((New row, above fields again on new SVHC substance)",
          "required": false,
          "type": "button",
          "conditional": {
            "field": "I confirm that the packaging does not contain SVHC (Substances of Very High Concern) above the mandatory notification limit of 0.1% by weight (1000 ppm).",
            "equals": false
          }
        },
        {
          "text": "Recyclability & recycled content (Art 6-11)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Recyclability class",
          "required": false,
          "helperText": "PPWR design-for-recycling (2028)",
          "type": "select",
          "options": [
            "A (best)",
            "B",
            "C",
            "D",
            "E (worst)"
          ]
        },
        {
          "text": "Recyclability (%)",
          "required": false,
          "placeholder": "95"
        },
        {
          "text": "Recycled content (%)",
          "required": false,
          "placeholder": "100"
        },
        {
          "text": "Recycled content verified",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Recycling stream",
          "required": false,
          "type": "select",
          "options": [
            "PET",
            "HDPE",
            "PP",
            "LDPE",
            "Paper / board",
            "Glass",
            "Aluminium",
            "Steel",
            "Mixed / composite"
          ]
        },
        {
          "text": "Separable components",
          "required": false,
          "helperText": "cap/label separable",
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Compostable",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Compostability standard",
          "required": false,
          "placeholder": "EN 13432"
        },
        {
          "text": "Reusable Packaging (Art. 11)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Designed reuse cycles",
          "required": false,
          "placeholder": "20"
        },
        {
          "text": "Deposit scheme",
          "required": false,
          "placeholder": "SK Zálohový systém"
        },
        {
          "text": "Deposit amount (€)",
          "required": false,
          "placeholder": "0.15"
        },
        {
          "text": "Reuse system URL",
          "required": false
        },
        {
          "text": "Return points URL",
          "required": false
        },
        {
          "text": "Redirect to producer's product page",
          "required": false,
          "type": "checkbox",
          "helperText": "When enabled, consumers scanning this product's QR code will be redirected directly to the producer's product page instead of the DPP viewer. The DPP data remains accessible via GS1 Digital Link."
        },
        {
          "text": "Producer product page URL",
          "required": true,
          "placeholder": "https://example.com/products/my-bottle",
          "helperText": "Must start with https://",
          "conditional": {
            "field": "Redirect to producer's product page",
            "equals": true
          }
        },
        {
          "text": "EPR registration (Art 44/45)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "One registration per member state where the packaging is first placed on the market.",
          "required": false,
          "type": "description"
        },
        {
          "text": "Country",
          "required": false,
          "type": "country-picker",
          "searchable": true
        },
        {
          "text": "Scheme",
          "required": false,
          "placeholder": "Scheme name"
        },
        {
          "text": "Registration number",
          "required": false,
          "placeholder": "SK-2026-000142"
        },
        {
          "text": "Add EPR registration ((New row, above fields again on new EPR registration)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Conformity Assessment & Declaration of Conformity (Art. 38 / 39)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Preview DoC ↗",
          "required": false,
          "type": "button"
        },
        {
          "text": "Primary DoC ↗",
          "required": false,
          "type": "button"
        },
        {
          "text": "Download (Word)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Generate & save DoC",
          "required": false,
          "type": "button"
        },
        {
          "text": "View / manage saved DoC in Documents & Links →",
          "required": false,
          "type": "description"
        },
        {
          "text": "Generated from these fields with the logo, signature & stamp from Account. Word = edit/sign locally; Save to DPP = store a PDF among documents, visible to authorities only.",
          "required": false,
          "type": "description"
        },
        {
          "text": "I confirm that an EU Declaration of Conformity exists for this packaging.",
          "required": true,
          "type": "checkbox"
        },
        {
          "text": "Declaration of Conformity number",
          "required": true,
          "placeholder": "DOC-2026-001"
        },
        {
          "text": "Declaration date",
          "required": true,
          "type": "date-picker",
          "placeholder": "dd/mm/yyyy"
        },
        {
          "text": "The packaging complies with REACH requirements including SVHC obligations.",
          "required": false,
          "type": "checkbox"
        },
        {
          "text": "Third-party certifications (optional)",
          "required": false,
          "type": "tag-select",
          "options": [
            "RecyClass",
            "EuCertPlast",
            "ISCC PLUS",
            "FSC",
            "PEFC",
            "Blue Angel",
            "Nordic Swan",
            "Other"
          ],
          "helperText": "Select certifications or leave empty."
        },
        {
          "text": "The EU Declaration of Conformity is generated from these fields — use the buttons above. Keep it on file and present it to authorities on request; a signed scan can be uploaded under Documents & links.",
          "required": false,
          "type": "description"
        },
        {
          "text": "SUPPLEMENTARY — NOT PART OF THE DOC (OPTIONAL)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Assessment date",
          "required": false,
          "type": "date-picker",
          "placeholder": "dd/mm/yyyy"
        },
        {
          "text": "Test reports URL",
          "required": false,
          "placeholder": ""
        },
        {
          "text": "Retention (years)",
          "required": false,
          "placeholder": "10",
          "helperText": "5 single-use / 10 reusable"
        },
        {
          "text": "Carbon footprint (g CO₂e)",
          "required": false,
          "placeholder": "42.5"
        },
        {
          "text": "PEF declaration URL",
          "required": false,
          "placeholder": ""
        }
      ]
    },
    "product-packaging": {
      "label": "Product packaging",
      "fields": [
        {
          "text": "Product packaging",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Packaging & Packaging Waste Regulation (EU) 2025/40 (PPWR) · ESPR 2024/1781. Declare one row per packaging layer.",
          "required": false,
          "type": "note"
        },
        {
          "text": "Layer order",
          "required": false
        },
        {
          "text": "Layer label",
          "required": false,
          "placeholder": "Primary bottle / Outer carton / Transport pallet"
        },
        {
          "text": "Data source",
          "required": false,
          "type": "select",
          "options": [
            "Manual entry",
            "Lookup by GTIN (Productix)",
            "External passport provider link",
            "Packaging layer (from library)"
          ]
        },
        {
          "text": "Packaging layer (from library)",
          "required": false,
          "type": "select",
          "helperText": "Select a shared layer defined via CSV import; referenced, not copied - edit it once and every product using it updates",
          "conditional": {
            "field": "Data source",
            "equals": "Packaging layer (from library)"
          }
        },
        {
          "text": "Packaging GTIN",
          "required": false,
          "conditional": {
            "field": "Data source",
            "equals": "Lookup by GTIN (Productix)"
          }
        },
        {
          "text": "Packaging DPP URL",
          "required": false,
          "placeholder": "https://www.productix.io/01/04796037382921",
          "conditional": {
            "field": "Data source",
            "equals": "External passport provider link"
          }
        },
        {
          "text": "Packaging name",
          "required": false,
          "placeholder": "Brown corrugated carton",
          "conditional": {
            "field": "Data source",
            "equals": "Manual entry"
          }
        },
        {
          "text": "Packaging manufacturer",
          "required": false,
          "placeholder": "EcoPack Industries (Pvt) Ltd",
          "conditional": {
            "field": "Data source",
            "equals": "Manual entry"
          }
        },
        {
          "text": "Packaging manufacturer country",
          "required": false,
          "type": "country-picker",
          "searchable": true,
          "conditional": {
            "field": "Data source",
            "equals": "Manual entry"
          }
        },
        {
          "text": "Required for the Declaration of Conformity",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Layer type (PPWR)",
          "required": false,
          "type": "select",
          "options": [
            "Primary",
            "Secondary",
            "Tertiary"
          ]
        },
        {
          "text": "Weight (g)",
          "required": false,
          "placeholder": "50"
        },
        {
          "text": "Layer composition",
          "required": false,
          "type": "nested-section",
          "helperText": "What this layer is physically made of — one row per material (Ex. bottle body · cap · label).",
          "fields": [
            {
              "text": "Component",
              "required": false,
              "placeholder": "Paper tray"
            },
            {
              "text": "Material",
              "required": true,
              "type": "select",
              "options": [
                "Paper / Cardboard",
                "PET",
                "HDPE",
                "LDPE",
                "PP",
                "PS",
                "Other plastic",
                "Glass",
                "Aluminium",
                "Steel",
                "Wood",
                "Composite",
                "Biopolymer",
                "Other"
              ]
            },
            {
              "text": "Weight (g)",
              "required": false,
              "placeholder": "g"
            },
            {
              "text": "Recycled %",
              "required": false,
              "placeholder": "%"
            }
          ],
          "actions": [
            {
              "text": "Add component (New row on above component fields)",
              "type": "button"
            }
          ]
        },
        {
          "text": "Recyclability grade (Art. 6-11)",
          "required": false,
          "type": "select",
          "options": [
            "A",
            "B",
            "C",
            "Not recyclable"
          ]
        },
        {
          "text": "Reusable",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "EPR registration",
          "required": false,
          "type": "nested-section",
          "helperText": "Extended Producer Responsibility registration(s) - one row per country.",
          "fields": [
            {
              "text": "Country",
              "required": true,
              "type": "country-picker",
              "searchable": true
            },
            {
              "text": "Scheme name",
              "required": true,
              "placeholder": "Scheme name"
            },
            {
              "text": "Registration No.",
              "required": true,
              "placeholder": "Registration No."
            }
          ],
          "actions": [
            {
              "text": "Add EPR registration (New row on above EPR fields)",
              "type": "button"
            }
          ]
        },
        {
          "text": "CONFORMITY & DECLARATION OF CONFORMITY (ART 38/39)",
          "required": false,
