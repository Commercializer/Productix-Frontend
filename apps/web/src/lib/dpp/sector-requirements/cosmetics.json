        {
          "text": "Heavy metals Σ Pb+Cd+Hg+CrVI (ppm) - Art. 5",
          "required": false,
          "placeholder": "≤ 100"
        },
        {
          "text": "PFAS present - Art. 5",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Food-contact",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "PFAS-free",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Total fluorine (ppm)",
          "required": false
        },
        {
          "text": "Fluorine under limit",
          "required": false,
