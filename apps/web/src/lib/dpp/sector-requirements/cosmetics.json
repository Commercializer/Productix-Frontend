{
  "sector": "COSMETICS",
  "sourceName": "Cosmetics",
  "sections": {
    "product-identification": {
      "label": "Product identification",
      "fields": [
        {
          "text": "Product name",
          "required": true
        },
        {
          "text": "GTIN-14",
          "required": true,
          "helperText": "14-digit Global Trade Item Number"
        },
        {
          "text": "Sector",
          "required": true
        },
        {
          "text": "Brand name",
          "required": false
        },
        {
          "text": "Model number",
          "required": false
        },
        {
          "text": "Product category",
          "required": false
        },
        {
          "text": "HS Code",
          "required": false
        }
      ]
    },
    "manufacturer-importer": {
      "label": "Manufacturer & importer",
      "fields": [
        {
          "text": "Manufacturer name",
          "required": true
        },
        {
          "text": "Manufacturer country",
          "required": true,
          "type": "country-picker",
          "searchable": true
        },
        {
          "text": "Manufacturer address",
          "required": false
        },
        {
          "text": "Manufacturer contact",
          "required": false
        },
        {
          "text": "Manufacturing facility ID",
          "required": false
        },
        {
          "text": "Manufacturing facility / site",
          "required": false,
          "helperText": "plant code or GS1 GLN). Optional - one of the 4 EU DPP Registry identifiers."
        },
        {
          "text": "Facility ID scheme - None / GLN (GS1) / EU-OP / Other",
          "required": false,
          "helperText": "Optional. Pick GLN only if the Facility ID is a GS1 GLN - it's then validated (13 digits)."
        },
        {
          "text": "Importer name",
          "required": false,
          "helperText": "Required if manufacturer is outside EU",
          "helperTextStyle": "lite"
        },
        {
          "text": "Importer country",
          "required": false,
          "type": "country-picker",
          "searchable": true
        }
      ]
    },
    "product-specifications": {
      "label": "Product specifications",
      "explainerText": "Free-form cosmetics specifications displayed on the public viewer. Examples: Product type · Formulation · Skin/hair type · Volume · Key ingredients · Fragrance · Color · Application method · Packaging type · Vegan status · Dermatologically tested.",
      "explainerText2": "Add the spec rows a consumer would care about. Up to 40 rows.",
      "explainerTextStyle": "lite",
      "maxRows": 40,
      "fields": [
        {
          "text": "Add Spec (Custom rows)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Spec Title",
          "required": false,
          "placeholder": "Formulation"
        },
        {
          "text": "Spec Content",
          "required": false,
          "placeholder": "Lightweight Gel Cream"
        }
      ]
    },
    "physical-properties": {
      "label": "Physical properties",
      "fields": [
        {
          "text": "Weight (kg)",
          "required": true
        },
        {
          "text": "Width (mm)",
          "required": false
        },
        {
          "text": "Height (mm)",
          "required": false
        },
        {
          "text": "Depth (mm)",
          "required": false
        },
        {
          "text": "Expected lifetime (years)",
          "required": false
        },
        {
          "text": "Warranty (years)",
          "required": false
        },
        {
          "text": "Manufacture date",
          "required": false,
          "type": "date-picker"
        },
        {
          "text": "Expiry date",
          "required": false,
          "type": "date-picker"
        }
      ]
    },
    "cosmetic-product-data": {
      "label": "Cosmetic product data",
      "fields": [
        {
          "text": "Cosmetic Products Regulation (EC) 1223/2009 · CPNP notification · Product Information File (PIF) · INCI labelling. Ingredients, safety assessment, claims, shelf life and sustainability data.",
          "required": false,
          "type": "note"
        },
        {
          "text": "Identification & Responsible Person",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Product type",
          "required": false,
          "type": "select",
          "options": [
            "Skincare",
            "Haircare",
            "Make-up",
            "Fragrance",
            "Oral care",
            "Sun care",
            "Body hygiene",
            "Deodorant",
            "Nail",
            "Other"
          ]
        },
        {
          "text": "CPNP reference",
          "required": true,
          "placeholder": "CPNP-12345678"
        },
        {
          "text": "Country of origin",
          "required": false,
          "placeholder": "FR",
          "helperText": "ISO code"
        },
        {
          "text": "Responsible person name",
          "required": true,
          "placeholder": "Acme Cosmetics EU s.r.o."
        },
        {
          "text": "Responsible person address",
          "required": false
        },
        {
          "text": "Composition (INCI, Art 19)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Ingredients (Full INCI list)",
          "required": true,
          "placeholder": "Aqua, Glycerin, Cetearyl Alcohol, Parfum, Limonene, Linalool...",
          "helperText": "descending order of weight"
        },
        {
          "text": "Structured ingredients (optional)",
          "required": false,
          "type": "note"
        },
        {
          "text": "INCI",
          "required": false,
          "placeholder": "Glycerin"
        },
        {
          "text": "Function",
          "required": false,
          "placeholder": "Humectant"
        },
        {
          "text": "%",
          "required": false,
          "placeholder": "5"
        },
        {
          "text": "Add ingredient (Add new row of ingredients, INCI · Function · % )",
          "required": false,
          "type": "button"
        },
        {
          "text": "Allergens (of 26)",
          "required": false,
          "placeholder": "Limonene, Linalool, Citral"
        },
        {
          "text": "CMR substances present",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Nanomaterials",
          "required": false,
          "placeholder": "Titanium Dioxide [nano]",
          "helperText": "labelled [nano]"
        },
        {
          "text": "Safety (Art 10/11)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Product Information File held (PIF)",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Microbiologically tested",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Challenge test passed",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Safety assessor",
          "required": false
        },
        {
          "text": "Safety assessment URL",
          "required": false
        },
        {
          "text": "Usage",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Period after opening (months)",
          "required": false,
          "placeholder": "12"
        },
        {
          "text": "Shelf life (months)",
          "required": false,
          "placeholder": "36"
        },
        {
          "text": "Target skin type",
          "required": false,
          "placeholder": "Sensitive"
        },
        {
          "text": "Usage instructions",
          "required": false
        },
        {
          "text": "Warnings",
          "required": false,
          "placeholder": "Avoid contact with eyes. For external use only."
        },
        {
          "text": "Claims & testing",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Not tested on animals",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Vegan",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Organic certified",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Clinically tested",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Claims",
          "required": false,
          "placeholder": "Dermatologically tested · Hypoallergenic"
        },
        {
          "text": "Environmental",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Microplastics free",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Packaging recyclable",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Refillable",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Recycled content (%)",
          "required": false,
          "placeholder": "50"
        },
        {
          "text": "Biodegradability (%)",
          "required": false,
          "placeholder": "95"
        },
        {
          "text": "Documents & certifications",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Product Information File URL",
          "required": false
        },
        {
          "text": "Certifications",
          "required": false,
          "placeholder": "COSMOS · Leaping Bunny"
        }
      ]
    },
    "product-packaging": {
      "label": "Product packaging",
      "fields": [
        {
          "text": "Product packaging",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Packaging & Packaging Waste Regulation (EU) 2025/40 (PPWR) · ESPR 2024/1781. Declare one row per packaging layer.",
          "required": false,
          "type": "note"
        },
        {
          "text": "Layer order",
          "required": false
        },
        {
          "text": "Layer label",
          "required": false,
          "placeholder": "Primary bottle / Outer carton / Transport pallet"
        },
        {
          "text": "Data source",
          "required": false,
          "type": "select",
          "options": [
            "Manual entry",
            "Lookup by GTIN (Productix)",
            "External passport provider link",
            "Packaging layer (from library)"
          ]
        },
        {
          "text": "Packaging layer (from library)",
          "required": false,
          "type": "select",
          "helperText": "Select a shared layer defined via CSV import; referenced, not copied - edit it once and every product using it updates",
          "conditional": {
            "field": "Data source",
            "equals": "Packaging layer (from library)"
          }
        },
        {
          "text": "Packaging GTIN",
          "required": false,
          "conditional": {
            "field": "Data source",
            "equals": "Lookup by GTIN (Productix)"
          }
        },
        {
          "text": "Packaging DPP URL",
          "required": false,
          "placeholder": "https://www.productix.io/01/04796037382921",
          "conditional": {
            "field": "Data source",
            "equals": "External passport provider link"
          }
        },
        {
          "text": "Packaging name",
          "required": false,
          "placeholder": "Brown corrugated carton",
          "conditional": {
            "field": "Data source",
            "equals": "Manual entry"
          }
        },
        {
          "text": "Packaging manufacturer",
          "required": false,
          "placeholder": "EcoPack Industries (Pvt) Ltd",
          "conditional": {
            "field": "Data source",
            "equals": "Manual entry"
          }
        },
        {
          "text": "Packaging manufacturer country",
          "required": false,
          "type": "country-picker",
          "searchable": true,
          "conditional": {
            "field": "Data source",
            "equals": "Manual entry"
          }
        },
        {
          "text": "Required for the Declaration of Conformity",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Layer type (PPWR)",
          "required": false,
          "type": "select",
          "options": [
            "Primary",
            "Secondary",
            "Tertiary"
          ]
        },
        {
          "text": "Weight (g)",
          "required": false,
          "placeholder": "50"
        },
        {
          "text": "Layer composition",
          "required": false,
          "type": "nested-section",
          "helperText": "What this layer is physically made of — one row per material (Ex. bottle body · cap · label).",
          "fields": [
            {
              "text": "Component",
              "required": false,
              "placeholder": "Paper tray"
            },
            {
              "text": "Material",
              "required": true,
              "type": "select",
              "options": [
                "Paper / Cardboard",
                "PET",
                "HDPE",
                "LDPE",
                "PP",
                "PS",
                "Other plastic",
                "Glass",
                "Aluminium",
                "Steel",
                "Wood",
                "Composite",
                "Biopolymer",
                "Other"
              ]
            },
            {
              "text": "Weight (g)",
              "required": false,
              "placeholder": "g"
            },
            {
              "text": "Recycled %",
              "required": false,
              "placeholder": "%"
            }
          ],
          "actions": [
            {
              "text": "Add component (New row on above component fields)",
              "type": "button"
            }
          ]
        },
        {
          "text": "Recyclability grade (Art. 6-11)",
          "required": false,
          "type": "select",
          "options": [
            "A",
            "B",
            "C",
            "Not recyclable"
          ]
        },
        {
          "text": "Reusable",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "EPR registration",
          "required": false,
          "type": "nested-section",
          "helperText": "Extended Producer Responsibility registration(s) - one row per country.",
          "fields": [
            {
              "text": "Country",
              "required": true,
              "type": "country-picker",
              "searchable": true
            },
            {
              "text": "Scheme name",
              "required": true,
              "placeholder": "Scheme name"
            },
            {
              "text": "Registration No.",
              "required": true,
              "placeholder": "Registration No."
            }
          ],
          "actions": [
            {
              "text": "Add EPR registration (New row on above EPR fields)",
              "type": "button"
            }
          ]
        },
        {
          "text": "CONFORMITY & DECLARATION OF CONFORMITY (ART 38/39)",
          "required": false,
          "type": "section-heading"
        },
        {
          "text": "DoC number",
          "required": false,
          "placeholder": "DoC-2026-001"
        },
        {
          "text": "DoC issue date",
          "required": false,
          "type": "date-picker",
          "placeholder": "dd/mm/yyyy"
        },
        {
          "text": "EU DoC exists",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "REACH / SVHC compliant",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Declaration of Conformity URL",
          "required": false,
          "placeholder": "https://..."
        },
        {
          "text": "Upload DoC file",
          "required": false,
          "type": "file-upload"
        },
        {
          "text": "Extract data from DoC",
          "required": false,
          "type": "button"
        },
        {
          "text": "Generate DoC (preview)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Generate + archive DoC",
          "required": false,
          "type": "button"
        },
        {
          "text": "Generated from the fields above (same template as the sector). Saves the product first. If your company logo/signature are not set, the DoC is generated without them.",
          "required": false,
          "type": "description"
        },
        {
          "text": "More PPWR data (optional)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Section 1 & 3 - CLASSIFICATION & MINIMISATION (ART 10)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Packaging category",
          "required": false,
          "placeholder": "e-commerce / grouped / transport"
        },
        {
          "text": "Packaging format",
          "required": false,
          "placeholder": "bottle / carton / pallet"
        },
        {
          "text": "Volume (l) — Art. 10",
          "required": false,
          "placeholder": "0.5"
        },
        {
          "text": "Dimensions — Art. 10",
          "required": false,
          "placeholder": "200×120×80 mm"
        },
        {
          "text": "Total weight (g)",
          "required": false
        },
        {
          "text": "Empty weight (g)",
          "required": false
        },
        {
          "text": "Packaging ratio",
          "required": false
        },
        {
          "text": "Mono-material",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Section 2 - ECONOMIC OPERATOR (ART 15/18)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Manufacturer role",
          "required": false,
          "type": "select",
          "options": [
            "Manufacturer",
            "Importer",
            "Authorised representative"
          ]
        },
        {
          "text": "Unique packaging identifier (Art 15(5))",
          "required": false,
          "placeholder": "EPR reg / GLN"
        },
        {
          "text": "Producer trademark",
          "required": false
        },
        {
          "text": "Importer",
          "required": false
        },
        {
          "text": "Importer address",
          "required": false
        },
        {
          "text": "Section 4 : SUBSTANCES (ART 5)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "No exact measured values in the source — substances are declared under the legal limits (heavy metals Σ ≤ 100 mg/kg; PFAS, BPA and total fluorine below limit). Enter a measured value only where a limit is exceeded.",
          "required": false,
          "type": "info-banner",
          "variant": "neutral"
