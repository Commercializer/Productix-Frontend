          "text": "Identification",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Vehicle category",
          "required": true,
          "type": "select",
          "options": [
            "M1 — Passenger car",
            "M2 — Bus ≤5t",
            "M3 — Bus >5t",
            "N1 — Van ≤3.5t",
            "N2 — Truck ≤12t",
            "N3 — Truck >12t",
            "L — 2/3-wheeler",
            "O — Trailer",
            "T — Tractor"
