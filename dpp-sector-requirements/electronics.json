        },
        {
          "text": "IP rating",
          "required": false,
          "placeholder": "IP68"
        },
        {
          "text": "Drop resistance (m)",
          "required": false,
          "placeholder": "1.5"
        },
        {
          "text": "MTBF (hours)",
          "required": false,
          "placeholder": "50000"
        },
        {
          "text": "Scratch resistance",
          "required": false,
          "placeholder": "Gorilla Glass Victus 2"
        },
        {
          "text": "Warranty (years)",
          "required": false,
          "placeholder": "2"
        },
        {
          "text": "Compliance & footprint",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "CE marking",
          "required": true,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "WEEE registration no.",
          "required": false,
          "placeholder": "DE 12345678"
        },
        {
          "text": "Carbon footprint (kg CO₂e)",
          "required": false,
          "placeholder": "55"
        },
        {
          "text": "Declaration of Conformity URL",
          "required": true
        },
        {
          "text": "Take-back / trade-in URL",
          "required": false
        },
        {
          "text": "Certifications",
          "required": false,
          "placeholder": "Energy Star · EPEAT Gold · TCO Certified · Blue Angel"
        }
      ]
