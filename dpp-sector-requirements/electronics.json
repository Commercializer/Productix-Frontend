{
  "sector": "ELECTRONICS",
  "sourceName": "Electronics / ICT data",
  "sections": {
    "product-identification": {
      "label": "Product identification",
      "fields": [
        {
          "text": "Product name",
          "required": true
        },
        {
          "text": "GTIN-14",
          "required": true,
          "helperText": "14-digit Global Trade Item Number"
        },
        {
          "text": "Sector",
          "required": true
        },
        {
          "text": "Brand name",
          "required": false
        },
        {
          "text": "Model number",
          "required": false
        },
        {
          "text": "Product category",
          "required": false
        },
        {
          "text": "HS Code",
          "required": false
        }
      ]
    },
    "manufacturer-importer": {
      "label": "Manufacturer & importer",
      "fields": [
        {
          "text": "Manufacturer name",
          "required": true
        },
        {
          "text": "Manufacturer country",
          "required": true,
          "type": "country-picker",
          "searchable": true
        },
        {
          "text": "Manufacturer address",
          "required": false
        },
        {
          "text": "Manufacturer contact",
          "required": false
        },
        {
          "text": "Manufacturing facility ID",
          "required": false
        },
        {
          "text": "Manufacturing facility / site",
          "required": false,
          "helperText": "plant code or GS1 GLN). Optional - one of the 4 EU DPP Registry identifiers."
        },
        {
          "text": "Facility ID scheme - None / GLN (GS1) / EU-OP / Other",
          "required": false,
          "helperText": "Optional. Pick GLN only if the Facility ID is a GS1 GLN - it's then validated (13 digits)."
        },
        {
          "text": "Importer name",
          "required": false,
          "helperText": "Required if manufacturer is outside EU",
          "helperTextStyle": "lite"
        },
        {
          "text": "Importer country",
          "required": false,
          "type": "country-picker",
          "searchable": true
        }
      ]
    },
    "product-specifications": {
      "label": "Product specifications",
      "explainerText": "Free-form electronics specifications displayed on the public viewer. Examples: Product type · Dimensions · Weight · Power consumption · Operating voltage · Connectivity · Display size · Processor · Memory · Storage capacity.",
      "explainerText2": "Add the spec rows a consumer would care about. Up to 40 rows.",
      "explainerTextStyle": "lite",
      "maxRows": 40,
      "fields": [
        {
          "text": "Add Spec (Custom rows)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Spec Title",
          "required": false,
          "placeholder": "Movement"
        },
        {
          "text": "Spec Content",
          "required": false,
          "placeholder": "Calibre 4131 · Chronograph"
        }
      ]
    },
    "physical-properties": {
      "label": "Physical properties",
      "fields": [
        {
          "text": "Weight (kg)",
          "required": true
        },
        {
          "text": "Width (mm)",
          "required": false
        },
        {
          "text": "Height (mm)",
          "required": false
        },
        {
          "text": "Depth (mm)",
          "required": false
        },
        {
          "text": "Expected lifetime (years)",
          "required": false
        },
        {
          "text": "Warranty (years)",
          "required": false
        },
        {
          "text": "Manufacture date",
          "required": false,
          "type": "date-picker"
        }
      ]
    },
    "carbon-footprint": {
      "label": "Carbon footprint",
      "fields": [
        {
          "text": "ESPR 2024/1781 · Art. 7(2)(b) - product carbon footprint",
          "required": false,
          "type": "note"
        },
        {
          "text": "Total CO₂ equivalent (kg)",
          "required": true,
          "helperText": "Mandatory for batteries ≥2kWh from Feb 2027"
        },
        {
          "text": "Methodology",
          "required": false,
          "helperText": "Ex: ISO 14067:2018"
        },
        {
          "text": "Manufacturing phase (kg CO₂)",
          "required": false
        },
        {
          "text": "Transport phase (kg CO₂)",
          "required": false
        },
        {
          "text": "Use phase (kg CO₂)",
          "required": false
        },
        {
          "text": "End of life phase (kg CO₂)",
          "required": false
        },
        {
          "text": "EPD declaration URL",
          "required": false
        }
      ]
    },
    "recycled-content": {
      "label": "Recycled content",
      "fields": [
        {
          "text": "ESPR 2024/1781 · Art. 7(2)(c) - recycled content",
          "required": false,
          "type": "note"
        },
        {
          "component": "info_banner",
          "variant": "success",
          "text": "Battery targets 2031 — Cobalt ≥16% · Lithium ≥6% · Nickel ≥6% · Lead ≥85%"
        },
        {
          "text": "Total recycled content (%)",
          "required": true,
          "helperText": "Mandatory for batteries from 2031"
        },
        {
          "text": "Pre-consumer recycled (%)",
          "required": false
        },
        {
          "text": "Post-consumer recycled (%)",
          "required": false
        },
        {
          "text": "Renewable content (%)",
          "required": false
        },
        {
          "text": "Recyclability (%)",
          "required": false
        }
      ]
    },
    "material-composition": {
      "label": "Material composition",
      "fields": [
        {
          "text": "ESPR 2024/1781 · Art. 7(5) · Critical Raw Materials Act 2024/1252",
          "required": false,
          "type": "note"
        },
        {
          "text": "Declare all materials >0.1% by weight. Country of origin mandatory for Critical Raw Materials (CRM).",
          "required": false,
          "component": "info_banner",
          "variant": "warning"
        },
        {
          "type": "select",
          "name": "material_name",
          "label": "Material name",
          "required": false,
          "options": [
            "Lithium",
            "Cobalt",
            "Nickel",
            "Manganese",
            "Graphite",
            "Rare earth elements",
            "Platinum",
            "Palladium",
            "Indium",
            "Gallium",
            "Germanium",
            "Silicon metal",
            "Titanium",
            "Tungsten",
            "Niobium",
            "Tantalum",
            "Aluminum",
            "Steel",
            "Copper",
            "Iron",
            "Zinc",
            "Lead",
            "Tin",
            "Silver",
            "Gold",
            "Polypropylene (PP)",
            "Polyethylene (PE)",
            "PET",
            "ABS plastic",
            "Nylon",
            "Polycarbonate",
            "Cotton",
            "Polyester",
            "Glass",
            "Ceramic"
          ]
        },
        {
          "text": "Share (%)",
          "required": false
        },
        {
          "text": "Origin",
          "required": false,
          "type": "country-picker",
          "searchable": true
        },
        {
          "text": "Flags",
          "required": false,
          "type": "checkbox",
          "options": [
            "CRM",
            "Recycled"
          ]
        },
        {
          "text": "Rec. %",
          "required": false
        },
        {
          "text": "Add Material (New row, above fields again on new materials)",
          "required": false,
          "type": "button"
        }
      ]
    },
    "electronics-ict-data": {
      "label": "Electronics / ICT data",
      "fields": [
        {
          "text": "Electronics / ICT data",
          "required": false,
          "type": "section-heading"
        },
        {
          "text": "Device classification",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Device type",
          "required": true,
          "type": "select",
          "options": [
            "Smartphone",
            "Tablet",
            "Laptop",
            "Desktop",
            "PC",
            "Monitor",
            "TV",
            "Wearable",
            "Headphones / earbuds",
            "Speaker",
            "Router / modem",
            "Printer",
            "Camera",
            "Game console",
            "Small appliance",
            "Other"
          ]
        },
        {
          "text": "Form factor",
          "required": false,
          "placeholder": "bar / foldable / 2-in-1"
