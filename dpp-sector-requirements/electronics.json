        },
        {
          "text": "Security update years",
          "required": false,
          "placeholder": "5"
        },
        {
          "text": "End of support date",
          "required": false,
          "type": "date-picker"
        },
        {
          "text": "Firmware / updates URL",
          "required": false
        },
        {
          "text": "Battery endurance",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Battery capacity (mAh)",
          "required": false
        },
        {
          "text": "Rated cycles (to 80%)",
          "required": false,
          "helperText": "≥800 (Reg 2023/1670)"
        },
        {
          "text": "User-replaceable battery",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Battery replacement info URL",
          "required": false
        },
        {
          "text": "Connectivity & common charger",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Charging port (USB-C, Lightning, Micro-USB, Barrel / DC jack, Proprietary, None / wireless only) - (USB-C mandatory (RED 2022/2380))",
          "required": false,
          "type": "select",
          "options": [
            "USB-C",
            "Lightning",
            "Micro-USB",
            "Barrel / DC jack",
            "Proprietary",
            "None / wireless only"
          ],
          "helperText": "USB-C mandatory (RED 2022/2380)"
        },
        {
          "text": "USB-C common charger",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Max charging power (W)",
          "required": false
        },
        {
          "text": "Wireless charging",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Connectivity",
          "required": false,
          "placeholder": "Wi-Fi 6E, BT 5.3, 5G, NFC"
        },
        {
          "text": "Materials & substances (RoHS / REACH / WEEE)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "RoHS compliant",
          "required": false,
