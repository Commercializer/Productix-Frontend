          "options": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "F",
            "G"
          ]
        },
        {
          "text": "EPREL database ID",
          "required": false
        },
        {
          "text": "Power consumption (W)",
          "required": false
        },
        {
          "text": "Networked standby (W)",
          "required": false
        },
        {
          "text": "Annual energy (kWh)",
          "required": false
        },
        {
          "text": "External power supply",
