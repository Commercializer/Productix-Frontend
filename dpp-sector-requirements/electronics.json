        {
          "text": "Steps to reach battery",
          "required": false
        },
        {
          "text": "Self-repair programme",
          "required": false,
          "type": "select",
          "options": [
            "Yes",
            "No"
          ]
        },
        {
          "text": "Spare parts shop URL",
          "required": false
        },
        {
          "text": "Repair manual URL",
          "required": false
        },
        {
          "text": "Key spare parts & prices",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "Part",
          "required": false,
          "placeholder": "Display assembly"
        },
        {
          "text": "Price (€)",
          "required": false,
          "placeholder": "97.00"
        },
        {
          "text": "Years",
          "required": false,
          "placeholder": "6"
        },
        {
          "text": "Add spare part (Button - New row, above fields again on new spare part)",
          "required": false,
          "type": "button"
        },
        {
          "text": "Software & support (Reg 2023/1670)",
          "required": false,
          "type": "subtitle"
        },
        {
          "text": "OS update years",
          "required": false,
          "placeholder": "5",
